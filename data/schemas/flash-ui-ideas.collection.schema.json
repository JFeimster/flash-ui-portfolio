{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:flash-ui:ideas:collection:v2",
  "title": "FLASH-UI Ideas Collection",
  "description": "A portable JSON container for a batch of validated FLASH-UI ideas; does not replace the site/deployment registry.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "2.0.0",
      "default": "2.0.0"
    },
    "collection_name": {
      "type": "string",
      "description": "Optional display label for the idea collection.",
      "default": ""
    },
    "ideas": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/idea"
      },
      "default": []
    }
  },
  "required": [
    "ideas"
  ],
  "$defs": {
    "idea": {
      "title": "FLASH-UI Ideas",
      "description": "One reusable FLASH-UI concept record: creative brief, generation prompt, working features, build/deployment details, distribution, and commercial metadata. Store many records in an ideas collection. v2 retains v1 core fields.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "type": "string",
          "const": "2.0.0",
          "default": "2.0.0",
          "description": "Version of the registry entry structure; not a deployed application version."
        },
        "id": {
          "type": "string",
          "description": "Stable unique identifier for the concept; preserve across prompt revisions.",
          "default": ""
        },
        "name": {
          "type": "string",
          "description": "Human-facing name of the proposed site, widget, app, or dashboard.",
          "default": ""
        },
        "slug": {
          "type": "string",
          "description": "URL- and file-safe identifier, distinct from the display name.",
          "default": ""
        },
        "brand": {
          "type": "string",
          "description": "Brand, affiliate program, or product family associated with the concept.",
          "default": ""
        },
        "asset_type": {
          "type": "string",
          "description": "Format: directory, dashboard, landing page, funnel, widget, calculator, portal, generator, or other.",
          "default": ""
        },
        "category": {
          "type": "string",
          "description": "Discovery grouping, such as partner enablement, entertainment, creator tools, or acquisitions.",
          "default": ""
        },
        "use_case": {
          "type": "string",
          "description": "Practical job this asset performs and where it will be used.",
          "default": ""
        },
        "target_user": {
          "type": "string",
          "description": "Primary visitor or operator persona.",
          "default": ""
        },
        "primary_pain": {
          "type": "string",
          "description": "Specific problem or friction the visitor wants resolved.",
          "default": ""
        },
        "visitor_psychology": {
          "type": "string",
          "description": "Motivation, objections, urgency, and desired emotional outcome.",
          "default": ""
        },
        "core_message": {
          "type": "string",
          "description": "Single most important message or promise.",
          "default": ""
        },
        "visual_style": {
          "type": "string",
          "description": "Distinctive, idea-specific art direction; avoid generic design shorthand.",
          "default": ""
        },
        "color_palette": {
          "type": "array",
          "description": "Named colors or HEX values, ordered by role.",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "visual_motifs": {
          "type": "array",
          "description": "Textures, graphical treatments, typography cues, and interaction motifs.",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "hook": {
          "type": "string",
          "description": "Short, arresting headline or positioning line.",
          "default": ""
        },
        "hero_section": {
          "type": "object",
          "description": "Hero copy, on-screen composition, and above-the-fold emphasis.",
          "properties": {
            "headline": {
              "type": "string",
              "default": ""
            },
            "subheadline": {
              "type": "string",
              "default": ""
            },
            "visual_direction": {
              "type": "string",
              "default": ""
            },
            "trust_or_signal_elements": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "default": []
            }
          },
          "additionalProperties": false,
          "default": {
            "headline": "",
            "subheadline": "",
            "visual_direction": "",
            "trust_or_signal_elements": []
          }
        },
        "primary_cta": {
          "type": "string",
          "description": "Main call to action, phrased as button text.",
          "default": ""
        },
        "secondary_cta": {
          "type": "string",
          "description": "Optional secondary call to action, phrased as button text.",
          "default": ""
        },
        "layout_sections": {
          "type": "array",
          "description": "Ordered sections or major screen modules.",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "input_fields": {
          "type": "array",
          "description": "Inputs used by quizzes, calculators, applications, and generators.",
          "items": {
            "type": "object",
            "properties": {
              "key": {
                "type": "string",
                "default": ""
              },
              "label": {
                "type": "string",
                "default": ""
              },
              "input_type": {
                "type": "string",
                "description": "text, select, currency, number, date, checkbox, etc.",
                "default": ""
              },
              "options": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "default": []
              },
              "required": {
                "type": "boolean",
                "default": false
              }
            },
            "additionalProperties": false
          },
          "default": []
        },
        "generated_outputs": {
          "type": "array",
          "description": "User-visible results, reports, downloadable items, copy blocks, or exported content.",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "interaction_requirements": {
          "type": "array",
          "description": "Functional actions the exported static site must implement, not decorative mockups.",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "flash_ui_prompt": {
          "type": "string",
          "description": "Full copy-and-paste prompt that produces the asset in FLASH-UI.",
          "default": ""
        },
        "tech_stack": {
          "type": "array",
          "description": "Preferred implementation technologies: HTML, CSS, Tailwind, vanilla JS, etc.",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "auth_mode": {
          "type": "string",
          "description": "none, optional, member, admin, or planned authentication strategy.",
          "default": ""
        },
        "storage_mode": {
          "type": "string",
          "description": "none, localStorage, static JSON, public sheet, or authenticated backend.",
          "default": ""
        },
        "integrations": {
          "type": "array",
          "description": "External platforms, embed targets, webhooks, or APIs required or optional.",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "deployment_targets": {
          "type": "array",
          "description": "Intended hosting or embed destinations: Vercel, Wix, WordPress, etc.",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "data_sensitivity": {
          "type": "string",
          "description": "Public, partner-only, personal data, financial data, or other risk designation.",
          "default": ""
        },
        "monetization_model": {
          "type": "string",
          "description": "Lead magnet, affiliate, advertising, paid template, SaaS, service, or none.",
          "default": ""
        },
        "seo_keywords": {
          "type": "array",
          "description": "Search terms or topical clusters worth targeting.",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "quality_checks": {
          "type": "array",
          "description": "Functional, visual, accessibility, responsive, tracking, and security acceptance checks.",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "build_status": {
          "type": "string",
          "description": "Idea, prompt ready, generated, QA, deployed, archived, or other current status.",
          "default": ""
        },
        "priority": {
          "type": "string",
          "description": "Build priority or internal ranking.",
          "default": ""
        },
        "variant_group": {
          "type": "string",
          "description": "Canonical concept family; groups aesthetic versions without duplicating ideas.",
          "default": ""
        },
        "related_asset_ids": {
          "type": "array",
          "description": "IDs of related concepts and complementary tools.",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "source_references": {
          "type": "array",
          "description": "Notion, chat, document, or source links that originally inspired the concept.",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "notes": {
          "type": "string",
          "description": "Implementation tradeoffs, dependencies, assumptions, and open decisions.",
          "default": ""
        },
        "links": {
          "type": "object",
          "description": "Known links; blank means unassigned, not necessarily unpublished.",
          "properties": {
            "site_url": {
              "type": "string",
              "description": "Canonical public site URL, if live.",
              "default": ""
            },
            "preview_url": {
              "type": "string",
              "description": "Preview/development URL, e.g. Vercel preview.",
              "default": ""
            },
            "demo_url": {
              "type": "string",
              "description": "Public demo link, if different from site_url.",
              "default": ""
            },
            "github_repo_url": {
              "type": "string",
              "description": "GitHub repository URL.",
              "default": ""
            },
            "github_issue_url": {
              "type": "string",
              "description": "Planning issue or build queue URL.",
              "default": ""
            },
            "github_pr_url": {
              "type": "string",
              "description": "Current pull request URL.",
              "default": ""
            },
            "vercel_project_url": {
              "type": "string",
              "description": "Vercel dashboard project URL; private may require access.",
              "default": ""
            },
            "wix_page_url": {
              "type": "string",
              "description": "Related Wix page or article URL.",
              "default": ""
            },
            "notion_page_url": {
              "type": "string",
              "description": "Source specification or planning page URL.",
              "default": ""
            },
            "docs_url": {
              "type": "string",
              "description": "Documentation URL.",
              "default": ""
            },
            "download_url": {
              "type": "string",
              "description": "Approved downloadable build/ZIP URL.",
              "default": ""
            }
          },
          "additionalProperties": false,
          "default": {
            "site_url": "",
            "preview_url": "",
            "demo_url": "",
            "github_repo_url": "",
            "github_issue_url": "",
            "github_pr_url": "",
            "vercel_project_url": "",
            "wix_page_url": "",
            "notion_page_url": "",
            "docs_url": "",
            "download_url": ""
          }
        },
        "local_files": {
          "type": "object",
          "description": "Absolute/local paths are operator-specific; paths are metadata, not distributable artifact URLs.",
          "properties": {
            "project_folder": {
              "type": "string",
              "description": "Local project root, Windows or POSIX.",
              "default": ""
            },
            "source_zip": {
              "type": "string",
              "description": "Original FLASH-UI ZIP archive path.",
              "default": ""
            },
            "extracted_folder": {
              "type": "string",
              "description": "Unpacked source folder path.",
              "default": ""
            },
            "entry_file": {
              "type": "string",
              "description": "Main HTML file path; e.g. C:\\...\\index.html.",
              "default": ""
            },
            "data_folder": {
              "type": "string",
              "description": "Local data/config directory.",
              "default": ""
            },
            "build_output_folder": {
              "type": "string",
              "description": "Build/export folder.",
              "default": ""
            },
            "screenshots_folder": {
              "type": "string",
              "description": "Where QA screenshots are saved.",
              "default": ""
            }
          },
          "additionalProperties": false,
          "default": {
            "project_folder": "",
            "source_zip": "",
            "extracted_folder": "",
            "entry_file": "",
            "data_folder": "",
            "build_output_folder": "",
            "screenshots_folder": ""
          }
        },
        "media_assets": {
          "type": "object",
          "description": "Media references, relative paths, or absolute URLs; never embed binary data.",
          "properties": {
            "logo": {
              "type": "string",
              "description": "Logo URL/path.",
              "default": ""
            },
            "favicon": {
              "type": "string",
              "description": "Favicon URL/path.",
              "default": ""
            },
            "hero_image": {
              "type": "string",
              "description": "Hero visual URL/path.",
              "default": ""
            },
            "thumbnail": {
              "type": "string",
              "description": "Portfolio card thumbnail URL/path.",
              "default": ""
            },
            "profile_image": {
              "type": "string",
              "description": "Avatar/headshot/profile image URL/path.",
              "default": ""
            },
            "social_share_image": {
              "type": "string",
              "description": "Open Graph / social card URL/path.",
              "default": ""
            },
            "screenshots": {
              "type": "array",
              "description": "Screenshots by URL/path.",
              "items": {
                "type": "string"
              },
              "default": []
            },
            "reels": {
              "type": "array",
              "description": "Short-form promo reel/video URLs/paths.",
              "items": {
                "type": "string"
              },
              "default": []
            },
            "gallery": {
              "type": "array",
              "description": "Other visual/media asset URLs/paths.",
              "items": {
                "type": "string"
              },
              "default": []
            },
            "image_generation_prompts": {
              "type": "array",
              "description": "Production-ready prompts for artwork or mockups.",
              "items": {
                "type": "string"
              },
              "default": []
            },
            "alt_text": {
              "type": "string",
              "description": "Short descriptive alt text for main image.",
              "default": ""
            }
          },
          "additionalProperties": false,
          "default": {
            "logo": "",
            "favicon": "",
            "hero_image": "",
            "thumbnail": "",
            "profile_image": "",
            "social_share_image": "",
            "screenshots": [],
            "reels": [],
            "gallery": [],
            "image_generation_prompts": [],
            "alt_text": ""
          }
        },
        "ai_stack": {
          "type": "object",
          "description": "Composition metadata; lists can contain stable IDs, names, or URLs, preferably consistent within the registry.",
          "properties": {
            "agents": {
              "type": "array",
              "description": "Included or planned AI agent identifiers.",
              "items": {
                "type": "string"
              },
              "default": []
            },
            "custom_gpts": {
              "type": "array",
              "description": "Included or linked custom GPT identifiers.",
              "items": {
                "type": "string"
              },
              "default": []
            },
            "skills": {
              "type": "array",
              "description": "Agent skills, reusable procedures, or skill IDs.",
              "items": {
                "type": "string"
              },
              "default": []
            },
            "mcp_servers": {
              "type": "array",
              "description": "MCP servers integrated or planned.",
              "items": {
                "type": "string"
              },
              "default": []
            },
            "plugins": {
              "type": "array",
              "description": "ChatGPT/third-party app or plugin identifiers.",
              "items": {
                "type": "string"
              },
              "default": []
            },
            "models": {
              "type": "array",
              "description": "Supported/planned AI model IDs.",
              "items": {
                "type": "string"
              },
              "default": []
            },
            "automations": {
              "type": "array",
              "description": "Automation or scheduled workflow IDs.",
              "items": {
                "type": "string"
              },
              "default": []
            },
            "prompt_templates": {
              "type": "array",
              "description": "Prompt asset references/IDs.",
              "items": {
                "type": "string"
              },
              "default": []
            },
            "tools": {
              "type": "array",
              "description": "Companion tool IDs/names.",
              "items": {
                "type": "string"
              },
              "default": []
            },
            "execution_mode": {
              "type": "string",
              "description": "Static-only, client-side, server-assisted, or hosted-agent; describe actual status.",
              "default": ""
            }
          },
          "additionalProperties": false,
          "default": {
            "agents": [],
            "custom_gpts": [],
            "skills": [],
            "mcp_servers": [],
            "plugins": [],
            "models": [],
            "automations": [],
            "prompt_templates": [],
            "tools": [],
            "execution_mode": ""
          }
        },
        "pricing": {
          "type": "object",
          "description": "Commercial model and pricing; not a claim that checkout or payments are implemented.",
          "properties": {
            "model": {
              "type": "string",
              "description": "free, freemium, one-time, subscription, usage-based, affiliate, sponsorship, custom, etc.",
              "default": ""
            },
            "currency": {
              "type": "string",
              "description": "ISO currency code, e.g. USD.",
              "default": ""
            },
            "plans": {
              "type": "array",
              "description": "Available or proposed pricing plans.",
              "items": {
                "$ref": "#/$defs/pricing_plan"
              },
              "default": []
            },
            "trial_policy": {
              "type": "string",
              "description": "Optional trial policy/limits.",
              "default": ""
            },
            "payment_provider": {
              "type": "string",
              "description": "Configured or proposed provider, e.g. Stripe.",
              "default": ""
            },
            "checkout_url": {
              "type": "string",
              "description": "Primary checkout link if available.",
              "default": ""
            },
            "affiliate_program_url": {
              "type": "string",
              "description": "External program link or affiliate offer URL.",
              "default": ""
            },
            "revenue_streams": {
              "type": "array",
              "description": "Multiple revenue paths, e.g. leads, subscriptions, affiliate, sponsorship.",
              "items": {
                "type": "string"
              },
              "default": []
            }
          },
          "additionalProperties": false,
          "default": {
            "model": "",
            "currency": "",
            "plans": [],
            "trial_policy": "",
            "payment_provider": "",
            "checkout_url": "",
            "affiliate_program_url": "",
            "revenue_streams": []
          }
        },
        "product_bundle": {
          "type": "object",
          "description": "How this concept composes into a reusable suite rather than a standalone one-off.",
          "properties": {
            "bundle_name": {
              "type": "string",
              "description": "Name of reusable product/solution bundle.",
              "default": ""
            },
            "bundle_role": {
              "type": "string",
              "description": "Standalone, core, add-on, embed, lead magnet, white-label module, etc.",
              "default": ""
            },
            "parent_asset_id": {
              "type": "string",
              "description": "Parent idea/asset ID if applicable.",
              "default": ""
            },
            "bundled_asset_ids": {
              "type": "array",
              "description": "Related ideas packaged together.",
              "items": {
                "type": "string"
              },
              "default": []
            },
            "module_ids": {
              "type": "array",
              "description": "Reusable module/component IDs implemented or planned.",
              "items": {
                "type": "string"
              },
              "default": []
            },
            "embed_targets": {
              "type": "array",
              "description": "Pages/products into which this can be embedded.",
              "items": {
                "type": "string"
              },
              "default": []
            },
            "reusable_components": {
              "type": "array",
              "description": "Reusable UI or utility components, e.g. calculators, tables, cards.",
              "items": {
                "type": "string"
              },
              "default": []
            },
            "template_variables": {
              "type": "array",
              "description": "Variables used to personalize/white-label this asset.",
              "items": {
                "type": "string"
              },
              "default": []
            }
          },
          "additionalProperties": false,
          "default": {
            "bundle_name": "",
            "bundle_role": "",
            "parent_asset_id": "",
            "bundled_asset_ids": [],
            "module_ids": [],
            "embed_targets": [],
            "reusable_components": [],
            "template_variables": []
          }
        },
        "data_contract": {
          "type": "object",
          "description": "Implementation/data-flow boundary; especially important for partner/borrower personal data.",
          "properties": {
            "source_of_truth": {
              "type": "string",
              "description": "Canonical data system; blank if local-only/no backend.",
              "default": ""
            },
            "data_sources": {
              "type": "array",
              "description": "Read-only inputs/feeds, spreadsheets, APIs, static JSON.",
              "items": {
                "type": "string"
              },
              "default": []
            },
            "write_destinations": {
              "type": "array",
              "description": "Authorized write targets, e.g. Tally form, Supabase table.",
              "items": {
                "type": "string"
              },
              "default": []
            },
            "webhook_events": {
              "type": "array",
              "description": "Named incoming/outgoing webhook events.",
              "items": {
                "type": "string"
              },
              "default": []
            },
            "required_env_var_names": {
              "type": "array",
              "description": "Environment variable NAMES only, never values or tokens.",
              "items": {
                "type": "string"
              },
              "default": []
            },
            "tracked_entities": {
              "type": "array",
              "description": "Entity types: referral, partner, lead, asset, campaign, etc.",
              "items": {
                "type": "string"
              },
              "default": []
            },
            "sensitive_fields": {
              "type": "array",
              "description": "Sensitive data fields that must never be stored client-side.",
              "items": {
                "type": "string"
              },
              "default": []
            },
            "demo_data_policy": {
              "type": "string",
              "description": "Specify explicit demo data labelling, no fabricated live data.",
              "default": ""
            },
            "sync_strategy": {
              "type": "string",
              "description": "None, manual export, webhooks, scheduled job, etc.",
              "default": ""
            }
          },
          "additionalProperties": false,
          "default": {
            "source_of_truth": "",
            "data_sources": [],
            "write_destinations": [],
            "webhook_events": [],
            "required_env_var_names": [],
            "tracked_entities": [],
            "sensitive_fields": [],
            "demo_data_policy": "",
            "sync_strategy": ""
          }
        },
        "growth": {
          "type": "object",
          "description": "Traffic and conversion strategy separate from site functionality.",
          "properties": {
            "primary_conversion": {
              "type": "string",
              "description": "Measurable desired action: qualified app, referral, signup, click, etc.",
              "default": ""
            },
            "secondary_conversions": {
              "type": "array",
              "description": "Other intended outcomes.",
              "items": {
                "type": "string"
              },
              "default": []
            },
            "distribution_channels": {
              "type": "array",
              "description": "Organic search, social, email, partners, embeds, etc.",
              "items": {
                "type": "string"
              },
              "default": []
            },
            "campaign_tags": {
              "type": "array",
              "description": "UTM/campaign tags or named campaigns.",
              "items": {
                "type": "string"
              },
              "default": []
            },
            "seo_title": {
              "type": "string",
              "description": "Search title when different from concept name.",
              "default": ""
            },
            "meta_description": {
              "type": "string",
              "description": "Proposed search snippet.",
              "default": ""
            },
            "analytics_events": {
              "type": "array",
              "description": "Events to track without claiming implemented tracking.",
              "items": {
                "type": "string"
              },
              "default": []
            },
            "attribution_method": {
              "type": "string",
              "description": "Tracking ID, UTM, referral code, webhook, etc.",
              "default": ""
            }
          },
          "additionalProperties": false,
