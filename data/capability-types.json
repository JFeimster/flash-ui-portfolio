{
  "schema": "flash-ui-capability-types/v1",
  "packageStandard": "Agent Plugins 1.0.0",
  "modes": [
    {
      "id": "skill",
      "label": "Skill-only plugin",
      "portable": true,
      "requires": [
        "name",
        "instructions"
      ],
      "files": [
        "plugin.json",
        "skills/<slug>/SKILL.md",
        "COMPATIBILITY.md",
        "README.md"
      ]
    },
    {
      "id": "remote-mcp",
      "label": "Existing remote MCP connection",
      "portable": true,
      "requires": [
        "name",
        "instructions",
        "mcpUrl"
      ],
      "files": [
        "plugin.json",
        "mcp.json",
        "skills/<slug>/SKILL.md",
        "COMPATIBILITY.md",
        "README.md"
      ],
      "note": "Endpoint format only; actual server ownership, health, OAuth, scopes not verified"
    },
    {
      "id": "mcp-scaffold",
      "label": "MCP/API server scaffold",
      "portable": false,
      "requires": [
        "name",
        "instructions"
      ],
      "files": [
        "plugin.json",
        "MCP-SCAFFOLD.md",
        "COMPATIBILITY.md",
        "README.md"
      ]
    },
    {
      "id": "agent",
      "label": "Agent spec",
      "portable": "plugin manifest and skill only",
      "requires": [
        "name",
        "instructions"
      ],
      "files": [
        "plugin.json",
        "skills/<slug>/SKILL.md",
        "agents/openai.yaml",
        "COMPATIBILITY.md",
        "README.md"
      ]
    },
    {
      "id": "webhook",
      "label": "Webhook contract",
      "portable": false,
      "requires": [
        "name",
        "instructions"
      ],
      "files": [
        "plugin.json",
        "WEBHOOK-CONTRACT.md",
        "COMPATIBILITY.md",
        "README.md"
      ]
    }
  ],
  "pilot": {
    "name": "Flash-UI Prompt Architect",
    "status": "missing-authorized-source",
    "note": "Pilot template only. No instructions invented; user must supply full source files."
  }
}
