<svg width="300" height="120" viewBox="0 0 300 120" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <filter id="inkBleed">
      <feTurbulence type="fractalNoise" baseFrequency="0.04" numOctaves="5" result="noise" />
      <feDisplacementMap in="SourceGraphic" in2="noise" scale="3" xChannelSelector="R" yChannelSelector="G" />
      <feGaussianBlur stdDeviation="0.4" />
    </filter>
    <filter id="roughEdges">
      <feTurbulence type="turbulence" baseFrequency="0.08" numOctaves="2" result="rough" />
      <feDisplacementMap in="SourceGraphic" in2="rough" scale="2" />
    </filter>
  </defs>
  <g filter="url(#inkBleed)" transform="rotate(-6, 150, 60)">
    <!-- Outer Heavy Border -->
    <rect x="10" y="10" width="280" height="100" rx="3" fill="none" stroke="#9e1b1b" stroke-width="7" stroke-opacity="0.9" />
    <!-- Inner Fine Border -->
    <rect x="18" y="18" width="264" height="84" rx="1" fill="none" stroke="#9e1b1b" stroke-width="1.5" stroke-opacity="0.6" />
    
    <!-- Stamped Text -->
    <text x="50%" y="68" dominant-baseline="middle" text-anchor="middle" font-family="'Stardos Stencil', 'Courier Prime', monospace" font-size="46" font-weight="700" fill="#9e1b1b" style="letter-spacing: 6px; text-transform: uppercase;">APPROVED</text>
    
    <!-- Authentication Code -->
    <text x="50%" y="92" dominant-baseline="middle" text-anchor="middle" font-family="'Special Elite', 'Courier Prime', monospace" font-size="9" font-weight="bold" fill="#9e1b1b" style="letter-spacing: 2px; text-transform: uppercase; opacity: 0.8;">REQUISITION ID: VJD-772-BULLSHIT-DETECTOR</text>
    
    <!-- Random Ink Splatters/Imperfections -->
    <circle cx="20" cy="20" r="1.2" fill="#9e1b1b" opacity="0.4" filter="url(#roughEdges)" />
    <circle cx="280" cy="100" r="0.8" fill="#9e1b1b" opacity="0.3" filter="url(#roughEdges)" />
    <circle cx="150" cy="15" r="1" fill="#9e1b1b" opacity="0.5" filter="url(#roughEdges)" />
  </g>
</svg>