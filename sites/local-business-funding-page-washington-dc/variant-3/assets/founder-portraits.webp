<svg width="1200" height="800" viewBox="0 0 1200 800" xmlns="http://www.w3.org/2000/svg">
    <!-- Background -->
    <rect width="1200" height="800" fill="#0A1629"/>
    
    <!-- Editorial Grid Lines -->
    <line x1="400" y1="0" x2="400" y2="800" stroke="#C5A059" stroke-opacity="0.1" stroke-width="1"/>
    <line x1="800" y1="0" x2="800" y2="800" stroke="#C5A059" stroke-opacity="0.1" stroke-width="1"/>
    
    <!-- Portrait 1: K-Street Consultant (Upper Left) -->
    <g transform="translate(50, 50)">
        <rect width="300" height="340" fill="#162B45"/>
        <path d="M150 80C177.614 80 200 102.386 200 130C200 157.614 177.614 180 150 180C122.386 180 100 157.614 100 130C100 102.386 122.386 80 150 80Z" fill="#C5A059" fill-opacity="0.8"/>
        <path d="M60 300C60 240 100 200 150 200C200 200 240 240 240 300V340H60V300Z" fill="#C5A059" fill-opacity="0.6"/>
        <rect x="20" y="20" width="40" height="2" fill="#C5A059"/>
        <text x="20" y="320" font-family="Playfair Display, serif" font-size="14" fill="#C5A059" letter-spacing="1">EST. 2014 / K STREET</text>
    </g>

    <!-- Portrait 2: Ward 7 Entrepreneur (Upper Right) -->
    <g transform="translate(450, 50)">
        <rect width="300" height="340" fill="#162B45"/>
        <circle cx="150" cy="130" r="55" fill="#C5A059" fill-opacity="0.9"/>
        <path d="M70 340C70 260 110 210 150 210C190 210 230 260 230 340" fill="#C5A059" fill-opacity="0.4"/>
        <rect x="240" y="20" width="40" height="40" stroke="#C5A059" fill="none" stroke-width="1" stroke-opacity="0.5"/>
        <text x="20" y="320" font-family="Playfair Display, serif" font-size="14" fill="#C5A059" letter-spacing="1">EST. 2021 / WARD 7</text>
    </g>

    <!-- Portrait 3: Adams Morgan Restaurateur (Lower Left) -->
    <g transform="translate(50, 410)">
        <rect width="300" height="340" fill="#162B45"/>
        <path d="M110 100C110 80 190 80 190 100V150C190 180 110 180 110 150V100Z" fill="#C5A059" fill-opacity="0.7"/>
        <path d="M80 340L100 200H200L220 340H80Z" fill="#C5A059" fill-opacity="0.5"/>
        <circle cx="260" cy="40" r="15" stroke="#C5A059" fill="none" stroke-width="1"/>
        <text x="20" y="320" font-family="Playfair Display, serif" font-size="14" fill="#C5A059" letter-spacing="1">EST. 2008 / ADAMS MORGAN</text>
    </g>

    <!-- Portrait 4: Navy Yard Tech Lead (Lower Right) -->
    <g transform="translate(850, 410)">
        <rect width="300" height="340" fill="#162B45"/>
        <rect x="110" y="80" width="80" height="100" rx="40" fill="#C5A059" fill-opacity="0.8"/>
        <path d="M80 340C80 250 220 250 220 340" fill="#C5A059" fill-opacity="0.6"/>
        <line x1="20" y1="20" x2="60" y2="60" stroke="#C5A059" stroke-width="1" stroke-opacity="0.4"/>
        <text x="20" y="320" font-family="Playfair Display, serif" font-size="14" fill="#C5A059" letter-spacing="1">EST. 2019 / NAVY YARD</text>
    </g>

    <!-- Central Branding Overlay -->
    <rect x="400" y="350" width="400" height="100" fill="#0A1629" stroke="#C5A059" stroke-width="2"/>
    <text x="600" y="400" font-family="Playfair Display, serif" font-size="24" fill="#FFFFFF" text-anchor="middle" letter-spacing="4">THE DC IMPACT GALLERY</text>
    <text x="600" y="430" font-family="Inter, sans-serif" font-size="10" fill="#C5A059" text-anchor="middle" letter-spacing="2" font-weight="600">EDITORIAL FINTECH PROFILES</text>

    <!-- Grain Overlay (Simulated) -->
    <filter id="noise">
        <feTurbulence type="fractalNoise" baseFrequency="0.65" numOctaves="3" stitchTiles="stitch"/>
        <feColorMatrix type="saturate" values="0"/>
        <feComponentTransfer>
            <feFuncA type="linear" slope="0.05"/>
        </feComponentTransfer>
    </filter>
    <rect width="1200" height="800" filter="url(#noise)" pointer-events="none"/>
</svg>