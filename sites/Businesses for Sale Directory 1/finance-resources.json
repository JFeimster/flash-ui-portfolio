```html
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>CREATIVE FINANCE VAULT | EQUITY TERMINAL</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;700;800&family=JetBrains+Mono:wght@400;700&display=swap" rel="stylesheet">
    <style>
        :root {
            --obsidian: #050505;
            --graphite: #121212;
            --graphite-light: #1A1A1A;
            --bone: #F5F5F0;
            --acid-green: #C1FF00;
            --oxidized-copper: #8E522F;
            --copper-glow: #D97706;
            --border-thick: 2px;
        }

        * { margin: 0; padding: 0; box-sizing: border-box; }

        body {
            background-color: var(--obsidian);
            color: var(--bone);
            font-family: 'Inter', sans-serif;
            line-height: 1.6;
            padding: 0;
        }

        /* Grain Overlay */
        body::before {
            content: "";
            position: fixed;
            top: 0; left: 0; width: 100%; height: 100%;
            background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.65' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)'/%3E%3C/svg%3E");
            opacity: 0.04;
            pointer-events: none;
            z-index: 9999;
        }

        .container { max-width: 1000px; margin: 0 auto; padding: 4rem 2rem; }

        .vault-header {
            border-bottom: var(--border-thick) solid var(--bone);
            padding-bottom: 2rem;
            margin-bottom: 4rem;
        }

        .mono { font-family: 'JetBrains Mono', monospace; text-transform: uppercase; }
        
        .classification {
            color: var(--oxidized-copper);
            font-weight: 800;
            font-size: 0.8rem;
            letter-spacing: 0.2em;
            margin-bottom: 1rem;
            display: block;
        }

        h1 { font-size: clamp(2.5rem, 6vw, 4.5rem); font-weight: 800; line-height: 0.9; margin-bottom: 1.5rem; letter-spacing: -0.04em; }

        .editorial-intro {
            font-size: 1.25rem;
            color: #888;
            max-width: 700px;
            border-left: 2px solid var(--oxidized-copper);
            padding-left: 1.5rem;
        }

        /* Calculator Section */
        .calculator-grid {
            display: grid;
            grid-template-columns: 1fr 1.2fr;
            gap: 2px;
            background: var(--bone);
            border: var(--border-thick) solid var(--bone);
            margin: 4rem 0;
        }

        .calc-panel { background: var(--obsidian); padding: 2.5rem; }
        .calc-results { background: var(--graphite); padding: 2.5rem; }

        .calc-title { font-size: 1.5rem; margin-bottom: 2rem; color: var(--acid-green); }

        .input-group { margin-bottom: 1.5rem; }
        .input-group label { display: block; font-size: 0.7rem; margin-bottom: 0.5rem; color: #666; }
        .input-group input {
            width: 100%;
            background: var(--graphite-light);
            border: 1px solid #333;
            color: var(--bone);
            padding: 1rem;
            font-family: 'JetBrains Mono', monospace;
            font-size: 1.1rem;
            outline: none;
        }
        .input-group input:focus { border-color: var(--acid-green); }

        .result-row {
            display: flex;
            justify-content: space-between;
            align-items: baseline;
            padding: 1rem 0;
            border-bottom: 1px solid #222;
        }
        .result-label { font-family: 'JetBrains Mono', monospace; font-size: 0.75rem; color: #777; }
        .result-value { font-size: 1.5rem; font-weight: 800; }
        .result-value.highlight { color: var(--acid-green); font-size: 2.2rem; }

        /* Content Sections */
        .whitepaper-section {
            display: grid;
            grid-template-columns: 250px 1fr;
            gap: 3rem;
            margin-bottom: 6rem;
        }

        .section-sidebar h3 { font-size: 0.8rem; color: var(--oxidized-copper); margin-bottom: 1rem; }
        .content-body p { margin-bottom: 1.5rem; color: #BBB; }
        .content-body h2 { font-size: 2rem; margin-bottom: 1.5rem; }

        .callout {
            background: var(--graphite-light);
            padding: 2rem;
            border-left: 4px solid var(--acid-green);
            margin: 2rem 0;
        }

        .btn {
            display: inline-block;
            padding: 1rem 2rem;
            background: var(--acid-green);
            color: var(--obsidian);
            text-decoration: none;
            font-weight: 800;
            font-family: 'JetBrains Mono', monospace;
            text-transform: uppercase;
            transition: transform 0.2s;
        }
        .btn:hover { transform: translate(-4px, -4px); box-shadow: 4px 4px 0 var(--bone); }

        @media (max-width: 768px) {
            .calculator-grid, .whitepaper-section { grid-template-columns: 1fr; }
            .section-sidebar { border-bottom: 1px solid #333; padding-bottom: 1rem; }
        }
    </style>
</head>
<body>

    <div class="container">
        <header class="vault-header">
            <span class="classification mono">INTERNAL USE // STRATEGY VAULT v.4.0</span>
            <h1 class="mono">Creative Finance & Seller Note Vault</h1>
            <p class="editorial-intro">A technical guide to closing acquisitions with minimal senior debt. This repository details the mechanics of seller carry, performance earn-outs, and rollover equity structures.</p>
        </header>

        <section id="note-calculator">
            <h2 class="mono" style="margin-bottom: 1rem; font-size: 1rem;">Tool 01: Seller Note Amortization</h2>
            <div class="calculator-grid">
                <div class="calc-panel">
                    <div class="calc-title mono">Parameters</div>
                    <div class="input-group">
                        <label class="mono">Total Purchase Price ($)</label>
                        <input type="number" id="purchasePrice" value="1000000" oninput="calculateNote()">
                    </div>
                    <div class="input-group">
                        <label class="mono">Seller Note Percentage (%)</label>
                        <input type="number" id="notePercent" value="20" oninput="calculateNote()">
                    </div>
                    <div class="input-group">
                        <label class="mono">Interest Rate (APR %)</label>
                        <input type="number" id="interestRate" value="8" oninput="calculateNote()">
                    </div>
                    <div class="input-group">
                        <label class="mono">Amortization Period (Years)</label>
                        <input type="number" id="amortYears" value="5" oninput="calculateNote()">
                    </div>
                </div>
                <div class="calc-results">
                    <div class="calc-title mono">Debt Service</div>
                    <div class="result-row">
                        <div class="result-label mono">Principal Amount</div>
                        <div class="result-value" id="principalDisplay">$200,000</div>
                    </div>
                    <div class="result-row">
                        <div class="result-label mono">Monthly Payment</div>
                        <div class="result-value highlight" id="monthlyDisplay">$4,055</div>
                    </div>
                    <div class="result-row">
                        <div class="result-label mono">Total Interest Paid</div>
                        <div class="result-value" id="totalInterestDisplay">$43,317</div>
                    </div>
                    <div class="result-row" style="border: none;">
                        <div class="result-label mono">Total Note Cost</div>
                        <div class="result-value" id="totalCostDisplay">$243,317</div>
                    </div>
                    <div style="margin-top: 2rem;">
                        <a href="#" class="btn">Download Schedule</a>
                    </div>
                </div>
            </div>
        </section>

        <section class="whitepaper-section">
            <div class="section-sidebar">
                <h3 class="mono">Strategic Memo 01</h3>
                <p class="mono" style="font-size: 0.65rem; color: #555;">Topic: The Seller Carry Advantage</p>
            </div>
            <div class="content-body">
                <h2>Why Seller Financing is the Ultimate Risk Hedge</h2>
                <p>In mid-market acquisitions, a seller-carried note is more than just a financing gap-filler; it is a mechanism for alignment. By requiring the seller to maintain a financial stake in the post-acquisition success, the buyer secures an implicit warranty on the business's health.</p>
                <div class="callout">
                    <h4 class="mono" style="margin-bottom: 0.5rem; font-size: 0.8rem;">Pro-Tip: Structural Subordination</h4>
                    <p style="font-size: 0.9rem; color: var(--bone);">Ensure the seller note is "fully standby" if using SBA 7(a) financing to count the debt as equity injection. This can reduce your required cash-to-close to as little as 5%.</p>
                </div>
                <p>Typical terms range from 10% to 30% of the total purchase price. During periods of high interest rates, negotiating a sub-market rate on the seller note (e.g., 6% when prime is 8.5%) can significantly improve your Debt Service Coverage Ratio (DSCR).</p>
            </div>
        </section>

        <section class="whitepaper-section">
            <div class="section-sidebar">
                <h3 class="mono">Strategic Memo 02</h3>
                <p class="mono" style="font-size: 0.65rem; color: #555;">Topic: Earn-Out Architecture</p>
            </div>
            <div class="content-body">
                <h2>Structuring the "Stability" Earn-Out</h2>
                <p>Earn-outs are often utilized when there is a valuation gap between the buyer's offer and the seller's expectation. However, the most effective earn-outs are based on <strong>Gross Profit Retention</strong> rather than top-line Revenue to prevent the seller from inflating numbers through low-margin sales during the transition period.</p>
                <p>We recommend a "Floor and Cap" approach:</p>
                <ul style="margin-left: 1.5rem; margin-bottom: 2rem; color: #888; font-size: 0.95rem;">
                    <li style="margin-bottom: 0.5rem;"><strong>Floor:</strong> No payment unless 85% of TTM EBITDA is maintained.</li>
                    <li style="margin-bottom: 0.5rem;"><strong>Linear Scaling:</strong> Pro-rata payout between 85% and 100%.</li>
                    <li style="margin-bottom: 0.5rem;"><strong>Cap:</strong> Total earn-out not to exceed 20% of the total transaction value.</li>
                </ul>
            </div>
        </section>

        <footer style="margin-top: 6rem; border-top: 1px solid #222; padding-top: 2rem; display: flex; justify-content: space-between; align-items: center;">
            <div class="mono" style="font-size: 0.7rem; color: #444;">&copy; 2024 EQUITY TERMINAL INTEL</div>
            <div class="mono" style="font-size: 0.7rem; color: #444;">ENCRYPTED ACCESS ONLY</div>
        </footer>
    </div>

    <script>
        function calculateNote() {
            const price = parseFloat(document.getElementById('purchasePrice').value) || 0;
            const percent = parseFloat(document.getElementById('notePercent').value) || 0;
            const rate = (parseFloat(document.getElementById('interestRate').value) || 0) / 100 / 12;
            const years = parseFloat(document.getElementById('amortYears').value) || 0;
            const months = years * 12;

            const principal = price * (percent / 100);
            document.getElementById('principalDisplay').innerText = formatCurrency(principal);

            if (principal <= 0 || months <= 0) {
                document.getElementById('monthlyDisplay').innerText = "$0";
                document.getElementById('totalInterestDisplay').innerText = "$0";
                document.getElementById('totalCostDisplay').innerText = "$0";
                return;
            }

            let monthly;
            if (rate === 0) {
                monthly = principal / months;
            } else {
                monthly = principal * (rate * Math.pow(1 + rate, months)) / (Math.pow(1 + rate, months) - 1);
            }

            const totalPaid = monthly * months;
            const totalInterest = totalPaid - principal;

            document.getElementById('monthlyDisplay').innerText = formatCurrency(monthly);
            document.getElementById('totalInterestDisplay').innerText = formatCurrency(totalInterest);
            document.getElementById('totalCostDisplay').innerText = formatCurrency(totalPaid);
        }

        function formatCurrency(num) {
            return new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD', maximumFractionDigits: 0 }).format(num);
        }

        // Initialize
        calculateNote();
    </script>
</body>
</html>
