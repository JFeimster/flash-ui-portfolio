<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Calculator Preview Card</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Fira+Code:wght@400;500&family=Inter:wght@300;400;600;700&display=swap" rel="stylesheet">
    <style>
        :root {
            --bg-deep: #05070a;
            --bg-card: #0d1117;
            --bg-input: #161b22;
            --neon-blue: #00f2ff;
            --neon-green: #00ff9d;
            --text-main: #e6edf3;
            --text-dim: #8b949e;
            --border: #30363d;
            --accent-glow: rgba(0, 242, 255, 0.15);
            --font-mono: 'Fira Code', monospace;
            --font-sans: 'Inter', sans-serif;
        }

        body {
            margin: 0;
            padding: 40px;
            background-color: var(--bg-deep);
            display: flex;
            justify-content: center;
            align-items: center;
            font-family: var(--font-sans);
            min-height: 100vh;
        }

        .preview-card {
            width: 380px;
            background: var(--bg-card);
            border: 1px solid var(--border);
            border-radius: 16px;
            overflow: hidden;
            box-shadow: 0 20px 40px rgba(0,0,0,0.4);
            position: relative;
        }

        .card-header {
            padding: 20px;
            border-bottom: 1px solid var(--border);
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
        }

        .tag {
            background: rgba(0, 242, 255, 0.1);
            border: 1px solid var(--neon-blue);
            color: var(--neon-blue);
            font-size: 0.65rem;
            font-weight: 700;
            padding: 4px 8px;
            border-radius: 4px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .best-for {
            font-size: 0.75rem;
            color: var(--neon-green);
            margin-top: 8px;
            font-family: var(--font-mono);
        }

        .card-body {
            padding: 24px;
        }

        .mock-ui {
            background: var(--bg-input);
            border: 1px solid var(--border);
            border-radius: 12px;
            padding: 20px;
            margin-bottom: 20px;
        }

        .ui-label {
            font-size: 0.7rem;
            color: var(--text-dim);
            text-transform: uppercase;
            margin-bottom: 12px;
            display: block;
        }

        .slider-track {
            height: 4px;
            background: var(--border);
            border-radius: 2px;
            width: 100%;
            position: relative;
            margin: 15px 0;
        }

        .slider-thumb {
            position: absolute;
            width: 16px;
            height: 16px;
            background: var(--neon-blue);
            border-radius: 50%;
            top: 50%;
            left: 60%;
            transform: translate(-50%, -50%);
            box-shadow: 0 0 10px var(--neon-blue);
        }

        .result-box {
            text-align: center;
            margin-top: 20px;
            padding-top: 20px;
            border-top: 1px solid var(--border);
        }

        .result-value {
            font-size: 2rem;
            font-weight: 700;
            color: var(--text-main);
            display: block;
        }

        .result-label {
            font-size: 0.8rem;
            color: var(--text-dim);
        }

        .card-footer {
            padding: 16px 24px 24px;
        }

        .btn-mock {
            width: 100%;
            background: var(--neon-blue);
            color: var(--bg-deep);
            padding: 12px;
            border-radius: 6px;
            text-align: center;
            font-weight: 700;
            font-size: 0.9rem;
        }

        .card-title {
            font-size: 1.1rem;
            font-weight: 600;
            color: var(--text-main);
            margin: 0;
        }

        .grid-dots {
            position: absolute;
            top: 0;
            right: 0;
            width: 100px;
            height: 100px;
            background-image: radial-gradient(var(--border) 1px, transparent 1px);
            background-size: 10px 10px;
            opacity: 0.5;
        }
    </style>
</head>
<body>

    <div class="preview-card">
        <div class="grid-dots"></div>
        <div class="card-header">
            <div>
                <h3 class="card-title">Funding Estimator</h3>
                <div class="best-for">Best for Resource Portals</div>
            </div>
            <span class="tag">Calculator</span>
        </div>

        <div class="card-body">
            <div class="mock-ui">
                <span class="ui-label">Monthly Revenue</span>
                <div style="color: var(--text-main); font-weight: 600; font-family: var(--font-mono);">$125,000</div>
                <div class="slider-track">
                    <div style="position: absolute; height: 100%; width: 60%; background: var(--neon-blue); border-radius: 2px;"></div>
                    <div class="slider-thumb"></div>
                </div>

                <div class="result-box">
                    <span class="result-label">Estimated Funding Offer</span>
                    <span class="result-value" style="color: var(--neon-green); text-shadow: 0 0 15px rgba(0, 255, 157, 0.2);">$250k - $375k</span>
                </div>
            </div>
        </div>

        <div class="card-footer">
            <div class="btn-mock">Get Funded</div>
            <p style="text-align: center; font-size: 0.7rem; color: var(--text-dim); margin-top: 12px;">
                Instant qualification • No credit pull
            </p>
        </div>
    </div>

</body>
</html>