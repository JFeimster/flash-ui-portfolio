<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>THE ARMORY | Quote Index</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@700&family=Syne:wght@800&family=IBM+Plex+Mono:wght@500;700&display=swap" rel="stylesheet">
    <style>
        :root {
            --black: #000000;
            --white: #ffffff;
            --cream: #f4f1ea;
            --red: #ff3c00;
            --border: 4px solid #000000;
            --shadow: 8px 8px 0px #000000;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            cursor: crosshair;
        }

        body {
            background-color: var(--cream);
            color: var(--black);
            font-family: 'Space Grotesk', sans-serif;
            line-height: 1.1;
            padding-bottom: 100px;
        }

        .container {
            max-width: 1400px;
            margin: 0 auto;
            padding: 40px 20px;
        }

        header {
            background: var(--black);
            color: var(--white);
            padding: 40px 0;
            border-bottom: var(--border);
            margin-bottom: 40px;
        }

        .nav-link {
            color: var(--white);
            text-decoration: none;
            font-family: 'IBM Plex Mono', monospace;
            font-weight: bold;
            font-size: 0.9rem;
            border: 2px solid var(--white);
            padding: 5px 15px;
            transition: all 0.2s;
        }

        .nav-link:hover {
            background: var(--red);
            color: var(--black);
        }

        h1 {
            font-family: 'Syne', sans-serif;
            font-size: clamp(3rem, 8vw, 6rem);
            text-transform: uppercase;
            margin-top: 20px;
        }

        /* Search & Filters */
        .armory-controls {
            display: grid;
            grid-template-columns: 1fr auto auto;
            gap: 20px;
            margin-bottom: 60px;
            background: var(--white);
            border: var(--border);
            padding: 30px;
            box-shadow: var(--shadow);
        }

        @media (max-width: 900px) {
            .armory-controls { grid-template-columns: 1fr; }
        }

        .search-box {
            font-family: 'IBM Plex Mono', monospace;
            border: var(--border);
            padding: 15px;
            font-size: 1.2rem;
            width: 100%;
            outline: none;
        }

        .filter-group {
            display: flex;
            flex-direction: column;
            gap: 10px;
        }

        .filter-label {
            font-family: 'IBM Plex Mono', monospace;
            font-weight: bold;
            font-size: 0.8rem;
            text-transform: uppercase;
        }

        .filter-btns {
            display: flex;
            gap: 10px;
        }

        .tag-btn {
            background: transparent;
            border: 2px solid var(--black);
            padding: 8px 15px;
            font-family: 'IBM Plex Mono', monospace;
            font-weight: bold;
            text-transform: uppercase;
            font-size: 0.8rem;
            cursor: pointer;
            white-space: nowrap;
        }

        .tag-btn.active {
            background: var(--black);
            color: var(--white);
        }

        /* Grid Layout */
        .quote-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(350px, 1fr));
            gap: 30px;
        }

        .grenade-item {
            background: var(--white);
            border: var(--border);
            padding: 30px;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            transition: transform 0.2s, box-shadow 0.2s;
            position: relative;
        }

        .grenade-item:hover {
            transform: translate(-4px, -4px);
            box-shadow: 12px 12px 0px var(--red);
        }

        .grenade-text {
            font-size: 1.6rem;
            font-weight: 800;
            text-transform: uppercase;
            margin-bottom: 40px;
        }

        .grenade-footer {
            border-top: 2px solid var(--black);
            padding-top: 20px;
            display: flex;
            justify-content: space-between;
            align-items: flex-end;
        }

        .grenade-cat {
            font-family: 'IBM Plex Mono', monospace;
            font-weight: 700;
            font-size: 0.75rem;
            background: var(--black);
            color: var(--white);
            padding: 4px 8px;
            text-transform: uppercase;
        }

        .intensity-meter {
            display: flex;
            flex-direction: column;
            align-items: flex-end;
            gap: 5px;
        }

        .intensity-label {
            font-family: 'IBM Plex Mono', monospace;
            font-size: 0.6rem;
            font-weight: bold;
        }

        .intensity-bars {
            display: flex;
            gap: 3px;
        }

        .bar {
            width: 12px;
            height: 12px;
            border: 1px solid var(--black);
        }

        .bar.active {
            background: var(--red);
        }

        /* Empty State */
        #no-results {
            display: none;
            padding: 100px 0;
            text-align: center;
            font-size: 2rem;
            font-weight: 900;
            text-transform: uppercase;
            color: var(--red);
        }
    </style>
</head>
<body>

    <header>
        <div class="container">
            <div style="display: flex; justify-content: space-between; align-items: center;">
                <div style="font-family: 'IBM Plex Mono', monospace; font-weight: bold;">[ ARMORY v1.02 ]</div>
                <a href="index.html" class="nav-link">← RETURN TO BASE</a>
            </div>
            <h1>THE ARMORY</h1>
            <p style="font-family: 'IBM Plex Mono', monospace; margin-top: 10px; max-width: 600px;">A comprehensive, searchable archive of high-velocity insights. Filter by category or intensity level. Handle with caution.</p>
        </div>
    </header>

    <main class="container">
        <section class="armory-controls">
            <div class="filter-group">
                <span class="filter-label">SEARCH FRAGMENTS</span>
                <input type="text" id="searchInput" class="search-box" placeholder="Keywords (e.g. state, code, exit)..." oninput="filterQuotes()">
            </div>

            <div class="filter-group">
                <span class="filter-label">AMMUNITION TYPE</span>
                <div class="filter-btns" id="catFilters">
                    <button class="tag-btn active" onclick="setCategory('ALL')">ALL</button>
                    <button class="tag-btn" onclick="setCategory('FOUNDER TRUTHS')">FOUNDER TRUTHS</button>
                    <button class="tag-btn" onclick="setCategory('LIBERTY RIFFS')">LIBERTY RIFFS</button>
                    <button class="tag-btn" onclick="setCategory('JESTER JOKES')">JESTER JOKES</button>
                </div>
            </div>

            <div class="filter-group">
                <span class="filter-label">MIN INTENSITY</span>
                <div class="filter-btns" id="intensityFilters">
                    <button class="tag-btn active" onclick="setIntensity(1)">1+</button>
                    <button class="tag-btn" onclick="setIntensity(3)">3+</button>
                    <button class="tag-btn" onclick="setIntensity(5)">5!!</button>
                </div>
            </div>
        </section>

        <div id="no-results">NO EXPLOSIONS MATCH YOUR CRITERIA</div>
        <div class="quote-grid" id="quoteGrid">
            <!-- Dynamically Populated -->
        </div>
    </main>

    <script>
        const library = [
            { text: "Sovereignty is a skill, not a right.", cat: "LIBERTY RIFFS", intensity: 4 },
            { text: "The state is a hallucination with a budget.", cat: "LIBERTY RIFFS", intensity: 5 },
            { text: "Build things that make the government obsolete.", cat: "FOUNDER TRUTHS", intensity: 5 },
            { text: "Optimism is a moral duty, pessimism is a luxury of the bored.", cat: "FOUNDER TRUTHS", intensity: 3 },
            { text: "Everything is a subscription, but ownership is a revolution.", cat: "LIBERTY RIFFS", intensity: 4 },
            { text: "Protocol > Politics.", cat: "LIBERTY RIFFS", intensity: 3 },
            { text: "The only real vote is the one you cast with your feet.", cat: "LIBERTY RIFFS", intensity: 4 },
            { text: "Permission is for people who don't have code.", cat: "FOUNDER TRUTHS", intensity: 5 },
            { text: "Logic is the ultimate weapon of the unarmed.", cat: "JESTER JOKES", intensity: 2 },
            { text: "Consensus is a trap. Conviction is a tool.", cat: "FOUNDER TRUTHS", intensity: 4 },
            { text: "Taxes are the subscription fee for a service you can't cancel.", cat: "JESTER JOKES", intensity: 4 },
            { text: "Code is the only law that doesn't require a police force.", cat: "FOUNDER TRUTHS", intensity: 5 },
            { text: "Exit is the only real voice.", cat: "LIBERTY RIFFS", intensity: 3 },
            { text: "Stop asking for a seat at the table and build your own floor.", cat: "FOUNDER TRUTHS", intensity: 4 },
            { text: "They can't cancel what they can't coordinate.", cat: "LIBERTY RIFFS", intensity: 5 },
            { text: "Centralization is just a very slow way of failing.", cat: "FOUNDER TRUTHS", intensity: 3 },
            { text: "Democracy is two wolves and a lamb voting on what's for lunch.", cat: "JESTER JOKES", intensity: 4 },
            { text: "Be the glitch in the simulation.", cat: "JESTER JOKES", intensity: 2 },
            { text: "Your keys, your coins. Your code, your world.", cat: "LIBERTY RIFFS", intensity: 5 },
            { text: "Privacy is not about hiding, it's about protecting the sacred.", cat: "FOUNDER TRUTHS", intensity: 3 },
            { text: "Legacy systems are just ghosts in expensive suits.", cat: "JESTER JOKES", intensity: 3 },
            { text: "Anonymity is the digital equivalent of a clean slate.", cat: "LIBERTY RIFFS", intensity: 4 }
        ];

        let activeCat = 'ALL';
        let minIntensity = 1;

        function setCategory(cat) {
            activeCat = cat;
            document.querySelectorAll('#catFilters .tag-btn').forEach(btn => {
                btn.classList.toggle('active', btn.innerText === cat);
            });
            filterQuotes();
        }

        function setIntensity(lvl) {
            minIntensity = lvl;
            document.querySelectorAll('#intensityFilters .tag-btn').forEach(btn => {
                btn.classList.toggle('active', btn.innerText.includes(lvl.toString()));
            });
            filterQuotes();
        }

        function filterQuotes() {
            const searchTerm = document.getElementById('searchInput').value.toLowerCase();
            const filtered = library.filter(q => {
                const matchesSearch = q.text.toLowerCase().includes(searchTerm);
                const matchesCat = activeCat === 'ALL' || q.cat === activeCat;
                const matchesIntensity = q.intensity >= minIntensity;
                return matchesSearch && matchesCat && matchesIntensity;
            });

            renderQuotes(filtered);
        }

        function renderQuotes(items) {
            const grid = document.getElementById('quoteGrid');
            const noResults = document.getElementById('no-results');
            grid.innerHTML = '';

            if (items.length === 0) {
                noResults.style.display = 'block';
                return;
            }
            noResults.style.display = 'none';

            items.forEach(q => {
                const card = document.createElement('div');
                card.className = 'grenade-item';
                
                let bars = '';
                for(let i=1; i<=5; i++) {
                    bars += `<div class="bar ${i <= q.intensity ? 'active' : ''}"></div>`;
                }

                card.innerHTML = `
                    <div class="grenade-text">${q.text}</div>
                    <div class="grenade-footer">
                        <div class="grenade-cat">${q.cat}</div>
                        <div class="intensity-meter">
                            <span class="intensity-label">VELOCITY</span>
                            <div class="intensity-bars">${bars}</div>
                        </div>
                    </div>
                `;
                grid.appendChild(card);
            });
        }

        // Initial Load
        window.onload = () => renderQuotes(library);
    </script>
</body>
