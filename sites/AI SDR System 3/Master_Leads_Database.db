<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Master Leads Database | Vector Aura</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
    <style>
        :root {
            --bg-deep: #030303;
            --card-bg: rgba(15, 15, 20, 0.8);
            --border: rgba(255, 255, 255, 0.08);
            --primary: #8b5cf6;
            --secondary: #ec4899;
            --accent: #06b6d4;
            --text-main: #f8fafc;
            --text-dim: #94a3b8;
            --success: #10b981;
            --aura-1: rgba(139, 92, 246, 0.1);
            --aura-2: rgba(6, 182, 212, 0.1);
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            background-color: var(--bg-deep);
            color: var(--text-main);
            font-family: 'Inter', sans-serif;
            padding: 40px 20px;
            min-height: 100vh;
            display: flex;
            justify-content: center;
        }

        .db-wrapper {
            width: 100%;
            max-width: 1200px;
            animation: fadeIn 0.8s ease-out;
        }

        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(10px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .db-header {
            display: flex;
            justify-content: space-between;
            align-items: flex-end;
            margin-bottom: 32px;
            padding: 0 10px;
        }

        .db-title h2 {
            font-size: 28px;
            font-weight: 700;
            letter-spacing: -0.03em;
            background: linear-gradient(to right, #fff, var(--text-dim));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .db-title p {
            color: var(--text-dim);
            font-size: 14px;
            margin-top: 4px;
        }

        .db-controls {
            display: flex;
            gap: 12px;
        }

        .search-bar {
            background: rgba(255, 255, 255, 0.03);
            border: 1px solid var(--border);
            padding: 10px 16px;
            border-radius: 10px;
            color: white;
            font-size: 13px;
            width: 240px;
            outline: none;
        }

        .search-bar:focus {
            border-color: var(--accent);
        }

        .db-container {
            background: var(--card-bg);
            backdrop-filter: blur(20px);
            border: 1px solid var(--border);
            border-radius: 20px;
            overflow: hidden;
            box-shadow: 0 40px 100px -20px rgba(0,0,0,0.7);
        }

        table {
            width: 100%;
            border-collapse: collapse;
            text-align: left;
            font-size: 13px;
        }

        thead {
            background: rgba(255, 255, 255, 0.02);
            border-bottom: 1px solid var(--border);
        }

        th {
            padding: 16px 20px;
            font-weight: 600;
            color: var(--text-dim);
            text-transform: uppercase;
            letter-spacing: 0.05em;
            font-size: 11px;
        }

        td {
            padding: 18px 20px;
            border-bottom: 1px solid var(--border);
            vertical-align: middle;
        }

        tr:hover td {
            background: rgba(255, 255, 255, 0.01);
        }

        .lead-info {
            display: flex;
            flex-direction: column;
        }

        .lead-name {
            font-weight: 600;
            color: #fff;
        }

        .lead-company {
            font-size: 12px;
            color: var(--text-dim);
        }

        .status-pill {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 4px 10px;
            border-radius: 6px;
            font-size: 11px;
            font-weight: 600;
            background: rgba(255, 255, 255, 0.05);
        }

        .status-source { color: var(--accent); border: 1px solid rgba(6, 182, 212, 0.2); }
        .status-research { color: var(--primary); border: 1px solid rgba(139, 92, 246, 0.2); }
        .status-qualify { color: var(--secondary); border: 1px solid rgba(236, 72, 153, 0.2); }

        .niche-tag {
            font-family: 'JetBrains Mono', monospace;
            font-size: 11px;
            color: var(--text-dim);
            background: rgba(255, 255, 255, 0.03);
            padding: 2px 8px;
            border-radius: 4px;
        }

        .ai-note {
            max-width: 300px;
            color: var(--text-dim);
            font-size: 12px;
            line-height: 1.5;
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
            overflow: hidden;
        }

        .score-box {
            font-family: 'JetBrains Mono', monospace;
            font-weight: 600;
            color: var(--success);
        }

        .action-btn {
            background: transparent;
            border: 1px solid var(--border);
            color: var(--text-dim);
            padding: 6px 12px;
            border-radius: 8px;
            cursor: pointer;
            transition: 0.2s;
        }

        .action-btn:hover {
            border-color: var(--primary);
            color: #fff;
        }

        /* Aura accents */
        .db-aura {
            position: fixed;
            width: 800px;
            height: 800px;
            border-radius: 50%;
            filter: blur(140px);
            z-index: -1;
            opacity: 0.4;
        }
        .aura-top { top: -200px; right: -200px; background: var(--aura-1); }
        .aura-bottom { bottom: -200px; left: -200px; background: var(--aura-2); }
    </style>
</head>
<body>

    <div class="db-aura aura-top"></div>
    <div class="db-aura aura-bottom"></div>

    <div class="db-wrapper">
        <header class="db-header">
            <div class="db-title">
                <h2>Master Leads Database</h2>
                <p>Lead Intelligence & Qualification Pipeline</p>
            </div>
            <div class="db-controls">
                <input type="text" class="search-bar" placeholder="Search leads, niches, notes...">
                <button class="action-btn">Export CSV</button>
            </div>
        </header>

        <div class="db-container">
            <table>
                <thead>
                    <tr>
                        <th>Lead Profile</th>
                        <th>Niche / Type</th>
                        <th>Pipeline Status</th>
                        <th>AI Research Insights (GPT/Gemini)</th>
                        <th>Fit Score</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody id="lead-table-body">
                    <tr>
                        <td>
                            <div class="lead-info">
                                <span class="lead-name">Alex Rivera</span>
                                <span class="lead-company">Nexus Stream Inc.</span>
                            </div>
                        </td>
                        <td>
                            <div class="niche-tag">SaaS Founders</div>
                            <div style="font-size: 10px; color: var(--accent); margin-top: 4px;">B2B Fintech</div>
                        </td>
                        <td>
                            <div class="status-pill status-qualify">QUALIFY</div>
                        </td>
                        <td>
                            <p class="ai-note">Recent Series A. Expanding to EMEA. CEO active on LinkedIn discussing cross-border payment friction.</p>
                        </td>
                        <td><span class="score-box">9.4</span></td>
                        <td><button class="action-btn">Open</button></td>
                    </tr>
                    <tr>
                        <td>
                            <div class="lead-info">
                                <span class="lead-name">Sarah Chen</span>
                                <span class="lead-company">Orbit Analytics</span>
                            </div>
                        </td>
                        <td>
                            <div class="niche-tag">Data Platforms</div>
                            <div style="font-size: 10px; color: var(--accent); margin-top: 4px;">Enterprise AI</div>
                        </td>
                        <td>
                            <div class="status-pill status-research">RESEARCH</div>
                        </td>
                        <td>
                            <p class="ai-note">Scraping indicates 15% headcount growth in sales department. Potential legacy CRM migration interest.</p>
                        </td>
                        <td><span class="score-box">8.1</span></td>
                        <td><button class="action-btn">Open</button></td>
                    </tr>
                    <tr>
                        <td>
                            <div class="lead-info">
                                <span class="lead-name">Jordan Blake</span>
                                <span class="lead-company">Vanguard Logistics</span>
                            </div>
                        </td>
                        <td>
                            <div class="niche-tag">Operations</div>
                            <div style="font-size: 10px; color: var(--accent); margin-top: 4px;">Supply Chain</div>
                        </td>
                        <td>
                            <div class="status-pill status-source">SOURCE</div>
                        </td>
                        <td>
                            <p class="ai-note">Lead identified via Apollo. Waiting for automated Gemini profile enrichment for tech stack analysis.</p>
                        </td>
                        <td><span class="score-box">--</span></td>
                        <td><button class="action-btn">Open</button></td>
                    </tr>
                    <tr>
                        <td>
                            <div class="lead-info">
                                <span class="lead-name">Elena Kostas</span>
                                <span class="lead-company">Lumina Health</span>
                            </div>
                        </td>
                        <td>
                            <div class="niche-tag">Healthcare Tech</div>
                            <div style="font-size: 10px; color: var(--accent); margin-top: 4px;">MedTech</div>
                        </td>
                        <td>
                            <div class="status-pill status-qualify">QUALIFY</div>
                        </td>
                        <td>
                            <p class="ai-note">Strong alignment with compliance-first outreach. Previous buyer of similar SDR tools at HealthLine.</p>
                        </td>
                        <td><span class="score-box">9.8</span></td>
                        <td><button class="action-btn">Open</button></td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>

    <script>
        // Interactive row highlight logic
        const rows = document.querySelectorAll('tbody tr');
        rows.forEach(row => {
            row.addEventListener('click', () => {
                rows.forEach(r => r.style.background = 'transparent');
                row.style.background = 'rgba(139, 92, 246, 0.05)';
            });
        });
    </script>
</body>
</html>