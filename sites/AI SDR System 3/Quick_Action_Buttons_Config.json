        "color_hex": "#8b5cf6",
        "require_confirm": false
      },
      {
        "action_id": "rotate_proxies",
        "label": "Rotate Proxies",
        "description": "Force refresh of residential IP pool",
        "style": "accent_outline",
        "color_hex": "#06b6d4",
        "require_confirm": false
      },
      {
        "action_id": "flush_pipeline",
        "label": "Flush Queue",
        "description": "Clear all pending personalized drafts",
        "style": "secondary_outline",
        "color_hex": "#ec4899",
        "require_confirm": true
      },
      {
        "action_id": "sync_crm",
        "label": "CRM Sync",
        "description": "Force immediate push to Notion/Salesforce",
        "style": "standard",
        "color_hex": "#94a3b8",
        "require_confirm": false
      }
