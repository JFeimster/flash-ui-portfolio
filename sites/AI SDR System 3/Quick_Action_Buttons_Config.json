      },
      {
        "id": "input_market_niche",
        "label": "Market Niche",
        "type": "text",
        "placeholder": "e.g. SaaS Founders",
        "variable": "env.NICHE_PROFILE"
      },
      {
        "id": "input_business_type",
        "label": "Business Type",
        "type": "text",
        "placeholder": "e.g. B2B Fintech",
        "variable": "env.BIZ_TYPE"
      }
    ],
    "quick_action_buttons": [
      {
        "action_id": "emergency_stop",
        "label": "Emergency Stop",
        "description": "Immediate cessation of all outbound threads",
