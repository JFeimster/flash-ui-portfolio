{
  "component_metadata": {
    "file_name": "Quick_Action_Buttons_Config.json",
    "version": "2.4.0",
    "parent_ui": "AI SDR Engine | Vector Aura",
    "theme_reference": {
      "background": "#030303",
      "primary": "#8b5cf6",
      "secondary": "#ec4899",
      "accent": "#06b6d4",
      "text_dim": "#94a3b8"
    }
  },
