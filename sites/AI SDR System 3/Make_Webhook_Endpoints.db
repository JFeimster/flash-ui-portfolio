                <span class="log-msg">SYS: Database garbage collection completed</span>
            </div>
        </div>
    </div>

    <script>
        const consoleEl = document.getElementById('console');
        const operations = [
            { t: 'Lead_Send_Dispatch', s: 'POST', h: '200 OK', c: 'ok' },
            { t: 'FollowUp_Automation', s: 'GAS', h: 'Executed', c: 'ok' },
            { t: 'Email_Enrichment_API', s: 'GET', h: '429 Rate Limit', c: 'err' },
            { t: 'CRM_Sync_Worker', s: 'SYNC', h: 'Processed', c: 'ok' }
        ];

        function addLog() {
            const now = new Date();
            const timeStr = `[${now.getHours().toString().padStart(2, '0')}:${now.getMinutes().toString().padStart(2, '0')}:${now.getSeconds().toString().padStart(2, '0')}]`;
            const op = operations[Math.floor(Math.random() * operations.length)];
            
            const div = document.createElement('div');
            div.className = 'log-entry';
            div.innerHTML = `
                <span class="log-time">${timeStr}</span>
                <span class="log-msg ${op.c}">${op.s} /${op.t} - ${op.h}</span>
            `;
            
            consoleEl.prepend(div);
            if (consoleEl.children.length > 20) consoleEl.lastElementChild.remove();
        }

        setInterval(addLog, 3500);
    </script>
</body>
</html>