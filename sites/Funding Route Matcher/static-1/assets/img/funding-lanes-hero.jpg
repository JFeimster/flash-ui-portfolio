<svg width="1200" height="600" viewBox="0 0 1200 600" fill="none" xmlns="http://www.w3.org/2000/svg">
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@800&amp;family=JetBrains+Mono:wght@500&amp;display=swap');
        .title { font-family: 'Inter', sans-serif; font-weight: 800; text-transform: uppercase; letter-spacing: -2px; }
        .mono { font-family: 'JetBrains Mono', monospace; font-weight: 500; text-transform: uppercase; letter-spacing: 2px; }
    </style>
    
    <defs>
        <linearGradient id="main_grad" x1="0%" y1="0%" x2="100%" y2="100%">
            <stop offset="0%" stop-color="#00f2ff" stop-opacity="0.2" />
            <stop offset="100%" stop-color="#39ff14" stop-opacity="0.1" />
        </linearGradient>
        <linearGradient id="accent_grad" x1="0%" y1="0%" x2="100%" y2="0%">
            <stop offset="0%" stop-color="#00f2ff" />
            <stop offset="100%" stop-color="#39ff14" />
        </linearGradient>
        <pattern id="grid" width="60" height="60" patternUnits="userSpaceOnUse">
            <path d="M 60 0 L 0 0 0 60" fill="none" stroke="#1f222c" stroke-width="1" stroke-opacity="0.5"/>
        </pattern>
        <filter id="glow">
            <feGaussianBlur stdDeviation="15" result="blur" />
            <feComposite in="SourceGraphic" in2="blur" operator="over" />
        </filter>
    </defs>

    <!-- Background -->
    <rect width="1200" height="600" fill="#07080a"/>
    <rect width="1200" height="600" fill="url(#main_grad)"/>
    <rect width="1200" height="600" fill="url(#grid)"/>

    <!-- Perspective Lanes -->
    <g transform="translate(600, 700)">
        <path d="M -1200 -600 L 0 0 L 1200 -600" fill="none" stroke="#1f222c" stroke-width="2"/>
        <path d="M -800 -600 L 0 0 L 800 -600" fill="none" stroke="url(#accent_grad)" stroke-width="1" stroke-opacity="0.3"/>
        <path d="M -400 -600 L 0 0 L 400 -600" fill="none" stroke="url(#accent_grad)" stroke-width="4" filter="url(#glow)"/>
        <path d="M 0 -600 L 0 0" fill="none" stroke="#00f2ff" stroke-width="1" stroke-dasharray="20 20"/>
    </g>

    <!-- Focal Point UI -->
    <rect x="350" y="200" width="500" height="200" rx="24" fill="#111318" stroke="#1f222c" stroke-width="2"/>
    <rect x="374" y="224" width="60" height="20" rx="10" fill="rgba(0,242,255,0.1)" stroke="rgba(0,242,255,0.3)"/>
    <text x="384" y="238" fill="#00f2ff" font-size="10" class="mono">DATABASE</text>

    <text x="400" y="300" fill="#ffffff" font-size="48" class="title">FUNDING LANES</text>
    <text x="400" y="340" fill="#8a8f9d" font-size="16" font-family="Inter, sans-serif">KNOWLEDGE DIRECTORY V2.0</text>

    <!-- Floating Data Nodes -->
    <g filter="url(#glow)">
        <circle cx="150" cy="150" r="8" fill="#00f2ff"/>
        <circle cx="1050" cy="450" r="8" fill="#39ff14"/>
        <circle cx="200" cy="480" r="5" fill="#39ff14" opacity="0.5"/>
        <circle cx="1000" cy="120" r="5" fill="#00f2ff" opacity="0.5"/>
    </g>

    <!-- Scanning Line -->
    <rect x="0" y="295" width="1200" height="2" fill="url(#accent_grad)" opacity="0.5">
        <animate attributeName="y" values="0;600;0" dur="8s" repeatCount="indefinite" />
    </rect>

    <!-- HUD Elements -->
    <text x="50" y="50" fill="#1f222c" font-size="12" class="mono">SYS_AUTH: SUCCESS</text>
    <text x="50" y="70" fill="#1f222c" font-size="12" class="mono">INDEX_STATE: ACTIVE</text>
    <text x="1150" y="550" text-anchor="end" fill="#1f222c" font-size="12" class="mono">© MOONSHINE CAPITAL AI</text>

    <!-- Decorative Corner Accents -->
    <path d="M 20 100 L 20 20 L 100 20" fill="none" stroke="url(#accent_grad)" stroke-width="4"/>
    <path d="M 1180 500 L 1180 580 L 1100 580" fill="none" stroke="url(#accent_grad)" stroke-width="4"/>
</svg>