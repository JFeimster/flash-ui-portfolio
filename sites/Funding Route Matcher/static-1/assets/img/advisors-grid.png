<svg width="800" height="450" viewBox="0 0 800 450" fill="none" xmlns="http://www.w3.org/2000/svg">
  <!-- Background -->
  <rect width="800" height="450" rx="24" fill="#111318"/>
  <rect x="0.5" y="0.5" width="799" height="449" rx="23.5" stroke="#1f222c"/>
  
  <!-- Grid Lines -->
  <path d="M400 40V410" stroke="#1f222c" stroke-dasharray="4 4"/>
  <path d="M60 225H740" stroke="#1f222c" stroke-dasharray="4 4"/>

  <!-- Advisor 1: Real Estate -->
  <g transform="translate(80, 60)">
    <rect width="300" height="140" rx="16" fill="#1a1d26" stroke="#1f222c"/>
    <circle cx="50" cy="70" r="34" stroke="#00f2ff" stroke-width="2" fill="#0d0f14"/>
    <circle cx="50" cy="62" r="12" fill="#8a8f9d"/>
    <path d="M30 90C30 80 40 76 50 76C60 76 70 80 70 90" stroke="#8a8f9d" stroke-width="2"/>
    <text x="100" y="60" fill="#ffffff" font-family="Inter, sans-serif" font-size="18" font-weight="600">Sarah Jenkins</text>
    <text x="100" y="82" fill="#00f2ff" font-family="JetBrains Mono, monospace" font-size="12" font-weight="500">REAL ESTATE SPECIALIST</text>
    <rect x="100" y="95" width="160" height="4" rx="2" fill="#1f222c"/>
    <rect x="100" y="95" width="145" height="4" rx="2" fill="#00f2ff"/>
  </g>

  <!-- Advisor 2: E-commerce -->
  <g transform="translate(420, 60)">
    <rect width="300" height="140" rx="16" fill="#1a1d26" stroke="#39ff14" stroke-opacity="0.3"/>
    <circle cx="50" cy="70" r="34" stroke="#39ff14" stroke-width="2" fill="#0d0f14"/>
    <circle cx="50" cy="62" r="12" fill="#8a8f9d"/>
    <path d="M30 90C30 80 40 76 50 76C60 76 70 80 70 90" stroke="#8a8f9d" stroke-width="2"/>
    <text x="100" y="60" fill="#ffffff" font-family="Inter, sans-serif" font-size="18" font-weight="600">Marcus Chen</text>
    <text x="100" y="82" fill="#39ff14" font-family="JetBrains Mono, monospace" font-size="12" font-weight="500">REVENUE &amp; INVENTORY</text>
    <rect x="100" y="95" width="160" height="4" rx="2" fill="#1f222c"/>
    <rect x="100" y="95" width="155" height="4" rx="2" fill="#39ff14"/>
  </g>

  <!-- Advisor 3: Logistics/Equipment -->
  <g transform="translate(80, 250)">
    <rect width="300" height="140" rx="16" fill="#1a1d26" stroke="#1f222c"/>
    <circle cx="50" cy="70" r="34" stroke="#00f2ff" stroke-width="2" fill="#0d0f14"/>
    <circle cx="50" cy="62" r="12" fill="#8a8f9d"/>
    <path d="M30 90C30 80 40 76 50 76C60 76 70 80 70 90" stroke="#8a8f9d" stroke-width="2"/>
    <text x="100" y="60" fill="#ffffff" font-family="Inter, sans-serif" font-size="18" font-weight="600">Elena Rodriguez</text>
    <text x="100" y="82" fill="#00f2ff" font-family="JetBrains Mono, monospace" font-size="12" font-weight="500">LOGISTICS &amp; ASSETS</text>
    <rect x="100" y="95" width="160" height="4" rx="2" fill="#1f222c"/>
    <rect x="100" y="95" width="130" height="4" rx="2" fill="#00f2ff"/>
  </g>

  <!-- Advisor 4: Micro-funding -->
  <g transform="translate(420, 250)">
    <rect width="300" height="140" rx="16" fill="#1a1d26" stroke="#1f222c"/>
    <circle cx="50" cy="70" r="34" stroke="#39ff14" stroke-width="2" fill="#0d0f14"/>
    <circle cx="50" cy="62" r="12" fill="#8a8f9d"/>
    <path d="M30 90C30 80 40 76 50 76C60 76 70 80 70 90" stroke="#8a8f9d" stroke-width="2"/>
    <text x="100" y="60" fill="#ffffff" font-family="Inter, sans-serif" font-size="18" font-weight="600">David Kalu</text>
    <text x="100" y="82" fill="#39ff14" font-family="JetBrains Mono, monospace" font-size="12" font-weight="500">QUICK-CAPITAL LEAD</text>
    <rect x="100" y="95" width="160" height="4" rx="2" fill="#1f222c"/>
    <rect x="100" y="95" width="158" height="4" rx="2" fill="#39ff14"/>
  </g>

  <!-- Overlay Effects -->
  <defs>
    <linearGradient id="paint0_linear" x1="0" y1="0" x2="800" y2="450" gradientUnits="userSpaceOnUse">
      <stop stop-color="#00f2ff" stop-opacity="0.05"/>
      <stop offset="1" stop-color="#39ff14" stop-opacity="0.05"/>
    </linearGradient>
  </defs>
  <rect width="800" height="450" rx="24" fill="url(#paint0_linear)" style="mix-blend-mode:overlay; pointer-events:none;"/>
</svg>