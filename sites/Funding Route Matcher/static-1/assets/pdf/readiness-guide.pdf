<body>

    <div class="guide-container">
        <header>
            <div class="status-badge">Phase: Pre-Funding Nurture</div>
            <h1>Business <span>Fundability</span> Roadmap</h1>
            <p class="intro-text">Your match results indicated some gaps in documentation or credit history. Follow this roadmap to unlock premium capital rates.</p>
        </header>

        <!-- PHASE 1 -->
        <div class="roadmap-section">
            <div class="section-header">
                <div class="step-number">01</div>
                <h2>Corporate Foundation</h2>
            </div>
            <div class="checklist">
                <div class="check-item">
                    <div class="checkbox checked" onclick="toggleCheck(this)"></div>
                    <div class="item-content">
                        <h3>Entity Registration</h3>
                        <p>Active LLC, S-Corp, or C-Corp in good standing with Secretary of State.</p>
                    </div>
                </div>
                <div class="check-item">
                    <div class="checkbox" onclick="toggleCheck(this)"></div>
                    <div class="item-content">
                        <h3>Business Address</h3>
                        <p>Physical office or virtual office. Avoid using a residential address if possible.</p>
                    </div>
                </div>
                <div class="check-item">
                    <div class="checkbox" onclick="toggleCheck(this)"></div>
                    <div class="item-content">
                        <h3>Dedicated Phone & Email</h3>
                        <p>Professional domain email and 411-listed business line.</p>
                    </div>
                </div>
            </div>
            <div class="pro-tip">
                <h4>Pro Tip</h4>
                <p>Lenders use automated identity crawlers. If your business address doesn't match your SOS filing, it's an automatic high-risk flag.</p>
            </div>
        </div>

        <!-- PHASE 2 -->
        <div class="roadmap-section">
            <div class="section-header">
                <div class="step-number">02</div>
                <h2>Credit Architecture</h2>
            </div>
            <div class="checklist">
                <div class="check-item">
                    <div class="checkbox" onclick="toggleCheck(this)"></div>
                    <div class="item-content">
                        <h3>DUNS Number</h3>
                        <p>Register with Dun & Bradstreet to begin your business credit profile.</p>
                    </div>
                </div>
                <div class="check-item">
                    <div class="checkbox" onclick="toggleCheck(this)"></div>
                    <div class="item-content">
                        <h3>Net-30 Tradelines</h3>
                        <p>Open 3-5 accounts with vendors that report to Experian Business.</p>
                    </div>
                </div>
                <div class="check-item">
                    <div class="checkbox" onclick="toggleCheck(this)"></div>
                    <div class="item-content">
                        <h3>Personal Score Audit</h3>
                        <p>Aim for 680+ FICO. Resolve any recent delinquencies or high utilization.</p>
                    </div>
                </div>
            </div>
        </div>

        <!-- PHASE 3 -->
        <div class="roadmap-section">
            <div class="section-header">
                <div class="step-number">03</div>
                <h2>Financial Hygiene</h2>
            </div>
            <div class="checklist">
                <div class="check-item">
                    <div class="checkbox" onclick="toggleCheck(this)"></div>
                    <div class="item-content">
                        <h3>The 10k/mo Threshold</h3>
                        <p>Lenders look for consistent deposits. Try to maintain $10k+ monthly gross revenue.</p>
                    </div>
                </div>
                <div class="check-item">
                    <div class="checkbox" onclick="toggleCheck(this)"></div>
                    <div class="item-content">
                        <h3>Daily Balances</h3>
                        <p>Avoid overdrafts. Keep an average daily balance above $1,000 for 90 days.</p>
                    </div>
                </div>
                <div class="check-item">
                    <div class="checkbox" onclick="toggleCheck(this)"></div>
                    <div class="item-content">
                        <h3>Digital Bookkeeping</h3>
                        <p>Connect your bank to a system like QuickBooks for P&L generation.</p>
                    </div>
                </div>
            </div>
        </div>

        <footer class="guide-footer">
            <div class="progress-tracking">
                <div class="progress-label">
                    <span>Your Readiness Score</span>
                    <span id="progress-text">11% Complete</span>
                </div>
                <div class="progress-bar-bg">
                    <div id="progress-fill" class="progress-fill" style="width: 11%;"></div>
                </div>
            </div>
            <div class="cta-group">
                <button onclick="window.print()" class="btn btn-primary">Download Guide (PDF)</button>
                <button onclick="alert('Strategy call request sent.')" class="btn btn-outline">Request Coaching</button>
            </div>
            <p style="margin-top: 25px; font-size: 0.75rem; color: var(--text-muted); font-family: 'JetBrains Mono', monospace;">DOC_ID: MS-READINESS-2024-V2</p>
        </footer>
    </div>

    <script>
        function toggleCheck(el) {
            el.classList.toggle('checked');
            updateProgress();
        }

        function updateProgress() {
            const total = document.querySelectorAll('.checkbox').length;
            const checked = document.querySelectorAll('.checkbox.checked').length;
            const percent = Math.round((checked / total) * 100);
            
            document.getElementById('progress-fill').style.width = percent + '%';
            document.getElementById('progress-text').innerText = percent + '% Complete';
        }
    </script>
</body>
</html>