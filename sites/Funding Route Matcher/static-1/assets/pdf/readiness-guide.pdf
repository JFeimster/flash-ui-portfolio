<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Business Readiness & Prep Guide | Moonshine Capital</title>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;800&family=JetBrains+Mono:wght@400;500&display=swap');

        :root {
            --bg-dark: #07080a;
            --card-bg: #111318;
            --card-border: #1f222c;
            --electric-blue: #00f2ff;
            --neon-green: #39ff14;
            --text-main: #ffffff;
            --text-muted: #8a8f9d;
            --accent-gradient: linear-gradient(135deg, #00f2ff 0%, #39ff14 100%);
            --transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: 'Inter', sans-serif;
        }

        body {
            background-color: var(--bg-dark);
            color: var(--text-main);
            line-height: 1.6;
            padding: 40px 20px;
        }

        .guide-container {
            max-width: 900px;
            margin: 0 auto;
            background: var(--card-bg);
            border: 1px solid var(--card-border);
            border-radius: 24px;
            overflow: hidden;
            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
        }

        header {
            padding: 60px 40px;
            border-bottom: 1px solid var(--card-border);
            background: radial-gradient(circle at top right, rgba(57, 255, 20, 0.05), transparent);
            position: relative;
        }

        .status-badge {
            display: inline-block;
            padding: 6px 12px;
            background: rgba(57, 255, 20, 0.1);
            color: var(--neon-green);
            border-radius: 100px;
            font-family: 'JetBrains Mono', monospace;
            font-size: 0.75rem;
            margin-bottom: 20px;
            border: 1px solid rgba(57, 255, 20, 0.2);
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        h1 {
            font-size: 2.5rem;
            font-weight: 800;
            letter-spacing: -1px;
            margin-bottom: 15px;
        }

        h1 span {
            background: var(--accent-gradient);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .intro-text {
            color: var(--text-muted);
            font-size: 1.1rem;
            max-width: 600px;
        }

        /* Roadmap Sections */
        .roadmap-section {
            padding: 40px;
            border-bottom: 1px solid var(--card-border);
        }

        .section-header {
            display: flex;
            align-items: center;
            gap: 20px;
            margin-bottom: 30px;
        }

        .step-number {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            background: var(--accent-gradient);
            color: #000;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 800;
            font-family: 'JetBrains Mono', monospace;
            flex-shrink: 0;
        }

        h2 {
            font-size: 1.5rem;
            font-weight: 600;
        }

        .checklist {
            list-style: none;
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
            gap: 15px;
        }

        .check-item {
            background: #1a1d26;
            border: 1px solid var(--card-border);
            padding: 20px;
            border-radius: 12px;
            display: flex;
            align-items: flex-start;
            gap: 15px;
            transition: var(--transition);
        }

        .check-item:hover {
            border-color: var(--electric-blue);
        }

        .checkbox {
            width: 20px;
            height: 20px;
            border: 2px solid var(--text-muted);
            border-radius: 4px;
            flex-shrink: 0;
            margin-top: 3px;
            cursor: pointer;
            position: relative;
        }

        .checkbox.checked {
            background: var(--neon-green);
            border-color: var(--neon-green);
        }

        .checkbox.checked::after {
            content: "✓";
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            color: #000;
            font-size: 12px;
            font-weight: bold;
        }

        .item-content h3 {
            font-size: 1rem;
            margin-bottom: 4px;
        }

        .item-content p {
            font-size: 0.85rem;
            color: var(--text-muted);
        }

        /* Tips Box */
        .pro-tip {
            margin-top: 25px;
            background: rgba(0, 242, 255, 0.03);
            border-left: 4px solid var(--electric-blue);
            padding: 20px;
            border-radius: 0 12px 12px 0;
        }

        .pro-tip h4 {
            color: var(--electric-blue);
            font-size: 0.8rem;
            text-transform: uppercase;
            letter-spacing: 1px;
            margin-bottom: 8px;
        }

        /* Footer Action */
        .guide-footer {
            padding: 40px;
            background: #0d0f14;
            text-align: center;
        }

        .progress-tracking {
            margin-bottom: 30px;
        }

        .progress-label {
            display: flex;
            justify-content: space-between;
            margin-bottom: 10px;
            font-size: 0.9rem;
            color: var(--text-muted);
        }

        .progress-bar-bg {
            height: 8px;
            background: var(--card-border);
            border-radius: 4px;
            overflow: hidden;
        }

        .progress-fill {
            height: 100%;
            background: var(--accent-gradient);
            width: 25%; /* Dynamic */
            transition: width 0.5s ease;
        }

        .cta-group {
            display: flex;
            gap: 15px;
            justify-content: center;
            flex-wrap: wrap;
        }

        .btn {
            padding: 14px 28px;
            border-radius: 10px;
            font-weight: 700;
            cursor: pointer;
            text-decoration: none;
            font-size: 0.9rem;
            transition: var(--transition);
        }

        .btn-primary {
            background: var(--accent-gradient);
            color: #000;
            border: none;
        }

        .btn-outline {
            background: transparent;
            border: 1px solid var(--card-border);
            color: var(--text-main);
        }

        .btn:hover {
            transform: translateY(-2px);
            filter: brightness(1.1);
        }

        @media (max-width: 768px) {
            header { padding: 40px 20px; }
            .roadmap-section { padding: 30px 20px; }
            h1 { font-size: 2rem; }
            .checklist { grid-template-columns: 1fr; }
        }

        @media print {
            body { background: white; color: black; padding: 0; }
            .guide-container { border: none; box-shadow: none; }
            .btn, .checkbox { display: none; }
            .check-item { border: 1px solid #eee; }
            .step-number { background: #000; color: #fff; }
        }
    </style>
</head>
<body>

    <div class="guide-container">
        <header>
            <div class="status-badge">Phase: Pre-Funding Nurture</div>
            <h1>Business <span>Fundability</span> Roadmap</h1>
            <p class="intro-text">Your match results indicated some gaps in documentation or credit history. Follow this 30-90 day roadmap to unlock premium capital rates.</p>
        </header>

        <!-- PHASE 1 -->
        <div class="roadmap-section">
            <div class="section-header">
                <div class="step-number">01</div>
                <h2>Corporate Foundation</h2>
            </div>
            <div class="checklist">
                <div class="check-item">
                    <div class="checkbox checked"></div>
                    <div class="item-content">
                        <h3>Entity Registration</h3>
                        <p>Active LLC, S-Corp, or C-Corp in good standing with Secretary of State.</p>
                    </div>
                </div>
                <div class="check-item">
                    <div class="checkbox"></div>
                    <div class="item-content">
                        <h3>Business Address</h3>
                        <p>Physical office or virtual office. Avoid using a residential address if possible.</p>
                    </div>
                </div>
                <div class="check-item">
                    <div class="checkbox"></div>
                    <div class="item-content">
                        <h3>Dedicated Phone & Email</h3>
                        <p>Professional domain email (not @gmail) and 411-listed business line.</p>
                    </div>
                </div>
            </div>
            <div class="pro-tip">
                <h4>Pro Tip</h4>
                <p>Lenders use automated "identity crawlers." If your business address doesn't match your SOS filing and your website, it's an automatic high-risk flag.</p>
            </div>
        </div>

        <!-- PHASE 2 -->
        <div class="roadmap-section">
            <div class="section-header">
                <div class="step-number">02</div>
                <h2>Credit Architecture</h2>
            </div>
            <div class="checklist">
                <div class="check-item">
                    <div class="checkbox"></div>
                    <div class="item-content">
                        <h3>DUNS Number</h3>
                        <p>Register with Dun & Bradstreet to begin your business credit profile.</p>
                    </div>
                </div>
                <div class="check-item">
                    <div class="checkbox"></div>
                    <div class="item-content">
                        <h3>Net-30 Tradelines</h3>
                        <p>Open 3-5 accounts with vendors that report to Experian Business (e.g., Uline, Grainger).</p>
                    </div>
                </div>
                <div class="check-item">
                    <div class="checkbox"></div>
                    <div class="item-content">
                        <h3>Personal Score Audit</h3>
                        <p>Aim for 680+ FICO. Resolve any recent delinquencies or high credit utilization.</p>
                    </div>
                </div>
            </div>
        </div>

        <!-- PHASE 3 -->
        <div class="roadmap-section">
            <div class="section-header">
                <div class="step-number">03</div>
                <h2>Financial Hygiene</h2>
            </div>
            <div class="checklist">
                <div class="check-item">
                    <div class="checkbox"></div>
                    <div class="item-content">
                        <h3>The 10k/mo Threshold</h3>
                        <p>Lenders look for consistent deposits. Try to maintain $10k+ monthly gross revenue.</p>
                    </div>
                </div>
                <div class="check-item">
                    <div class="checkbox"></div>
                    <div class="item-content">
                        <h3>Daily Balances</h3>
                        <p>Avoid "overdraft" status. Keep an average daily balance above $1,000 for 90 days.</p>
                    </div>
                </div>
                <div class="check-item">
                    <div class="checkbox"></div>
                    <div class="item-content">
                        <h3>Digital Bookkeeping</h3>
                        <p>Connect your bank to a system like QuickBooks for instant P&L generation.</p>
                    </div>
                </div>
            </div>
        </div>

        <footer class="guide-footer">
            <div class="progress-tracking">
                <div class="progress-label">
                    <span>Your Readiness Score</span>
                    <span>25% Complete</span>
                </div>
                <div class="progress-bar-bg">
                    <div class="progress-fill"></div>
                </div>
            </div>
            <div class="cta-group">
                <a href="javascript:window.print()" class="btn btn-primary">Download PDF Guide</a>
                <a href="#" class="btn btn-outline" onclick="alert('Connecting to an advisor...')">Speak with a Prep Coach</a>
                <a href="index.html" class="btn btn-outline">Back to Matcher</a>
            </div>
            <p style="margin-top: 25px; font-size: 0.75rem; color: var(--text-muted); font-family: 'JetBrains Mono', monospace;">DOC_ID: MS-READINESS-2024-V2</p>
        </footer>
    </div>

    <script>
        // Simple interactive element for the checklist
        document.querySelectorAll('.checkbox').forEach(box => {
            box.addEventListener('click', function() {
                this.classList.toggle('checked');
                updateProgress();
            });
        });

        function updateProgress() {
            const total = document.querySelectorAll('.checkbox').length;
            const checked = document.querySelectorAll('.checkbox.checked').length;
            const percent = Math.round((checked / total) * 100);
            
            document.querySelector('.progress-fill').style.width = percent + '%';
            document.querySelector('.progress-label span:last-child').innerText = percent + '% Complete';
        }
    </script>
</body>
</html><!DOCTYPE html>
