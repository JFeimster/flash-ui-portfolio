        }

        @media print {
            body { background: white; color: black; padding: 0; }
            .guide-container { border: none; box-shadow: none; max-width: 100%; }
            .btn, .checkbox, .guide-footer { display: none; }
            .check-item { border: 1px solid #eee; }
            .step-number { background: #000 !important; color: #fff !important; }
            h1 span { -webkit-text-fill-color: black; }
