{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Blueprint source registry record",
  "type": "object",
  "required": [
    "id",
    "title",
    "source_url",
    "source_kind",
    "status",
    "last_verified_at",
    "access"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "source_url": {
      "type": "string",
      "format": "uri"
    },
    "source_kind": {
      "enum": [
        "notion",
        "drive",
        "linkedin",
        "wix",
        "github",
        "vercel",
        "internal",
        "public"
      ]
    },
    "status": {
      "enum": [
        "published",
        "verified",
        "draft",
        "proposed",
        "unverified",
        "restricted"
      ]
    },
    "last_verified_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "access": {
      "enum": [
        "public",
        "internal",
        "restricted"
      ]
    },
    "integration": {
      "type": [
        "string",
        "null"
      ]
    },
    "notes": {
      "type": "string"
    }
  }
}
