{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/funding-product.schema.json",
  "title": "Funding Product",
  "type": "object",
  "required": [
    "name",
    "family",
    "public_safe_summary"
  ],
  "properties": {
    "name": {
      "type": "string"
    },
    "family": {
      "type": "string"
    },
    "credit_tier": {
      "type": "string"
    },
    "time_to_funding": {
      "type": "string"
    },
    "required_documents": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "fast_disqualifiers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "public_safe_summary": {
      "type": "string"
    },
    "internal_notes": {
      "type": "string"
    }
  },
  "additionalProperties": true
}
