{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/webhook-event.schema.json",
  "title": "Webhook Event",
  "type": "object",
  "required": [
    "event_id",
    "event_type",
    "created_at",
    "payload"
  ],
  "properties": {
    "event_id": {
      "type": "string"
    },
    "event_type": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "source": {
      "type": "string"
    },
    "payload": {
      "type": "object"
    },
    "signature_required": {
      "type": "boolean"
    },
    "replay_safe": {
      "type": "boolean"
    }
  },
  "additionalProperties": false
}
