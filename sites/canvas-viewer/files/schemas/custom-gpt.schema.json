{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/custom-gpt.schema.json",
  "title": "Custom GPT",
  "type": "object",
  "required": [
    "name",
    "description",
    "status"
  ],
  "properties": {
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "access_url": {
      "type": "string"
    },
    "profile_image_url": {
      "type": "string"
    },
    "category": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "published",
        "archived",
        "unknown"
      ]
    },
    "knowledge_files": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "conversation_starters": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true
}
