<svg width="1200" height="800" viewBox="0 0 1200 800" xmlns="http://www.w3.org/2000/svg">
    <defs>
        <linearGradient id="neonGradient" x1="0%" y1="0%" x2="100%" y2="0%">
            <stop offset="0%" style="stop-color:#00f2ff;stop-opacity:1" />
            <stop offset="100%" style="stop-color:#00ff9d;stop-opacity:1" />
        </linearGradient>
        <filter id="glow">
            <feGaussianBlur stdDeviation="4" result="coloredBlur"/>
            <feMerge>
                <feMergeNode in="coloredBlur"/>
                <feMergeNode in="SourceGraphic"/>
            </feMerge>
        </filter>
        <filter id="cardGlow">
            <feGaussianBlur stdDeviation="15" result="blur"/>
            <feFlood flood-color="#00f2ff" flood-opacity="0.1" result="flood"/>
            <feComposite in="flood" in2="blur" operator="in" result="glow"/>
            <feMerge>
                <feMergeNode in="glow"/>
                <feMergeNode in="SourceGraphic"/>
            </feMerge>
        </filter>
    </defs>

    <!-- Background -->
    <rect width="1200" height="800" fill="#05070a" />
    
    <!-- Grid Pattern -->
    <pattern id="grid" width="40" height="40" patternUnits="userSpaceOnUse">
        <path d="M 40 0 L 0 0 0 40" fill="none" stroke="#161b22" stroke-width="1"/>
    </pattern>
    <rect width="1200" height="800" fill="url(#grid)" />

    <!-- Header Area -->
    <text x="60" y="80" font-family="Inter, sans-serif" font-size="42" font-weight="700" fill="url(#neonGradient)" filter="url(#glow)">Moonshine Widget Library</text>
    <text x="60" y="115" font-family="Inter, sans-serif" font-size="18" fill="#8b949e">Customizable financing tools for partner ecosystems</text>

    <!-- Widget Grid -->
    
    <!-- 1. Readiness Score -->
    <g transform="translate(60, 180)">
        <rect width="340" height="260" rx="12" fill="#0d1117" stroke="#30363d" stroke-width="1" filter="url(#cardGlow)"/>
        <text x="25" y="40" font-family="Inter, sans-serif" font-size="14" font-weight="600" fill="#00f2ff" letter-spacing="1">READINESS SCORE</text>
        <circle cx="170" cy="140" r="60" fill="none" stroke="#161b22" stroke-width="12" />
        <path d="M 110 140 A 60 60 0 1 1 200 190" fill="none" stroke="url(#neonGradient)" stroke-width="12" stroke-linecap="round" filter="url(#glow)"/>
        <text x="170" y="145" font-family="Fira Code, monospace" font-size="28" font-weight="700" fill="#e6edf3" text-anchor="middle">850</text>
        <text x="170" y="165" font-family="Inter, sans-serif" font-size="10" fill="#8b949e" text-anchor="middle">EXCELLENT</text>
        <rect x="100" y="215" width="140" height="24" rx="4" fill="#00f2ff" />
        <text x="170" y="231" font-family="Inter, sans-serif" font-size="10" font-weight="700" fill="#05070a" text-anchor="middle">VIEW ANALYSIS</text>
    </g>

    <!-- 2. Route Matcher -->
    <g transform="translate(430, 180)">
        <rect width="340" height="260" rx="12" fill="#0d1117" stroke="#30363d" stroke-width="1" filter="url(#cardGlow)"/>
        <text x="25" y="40" font-family="Inter, sans-serif" font-size="14" font-weight="600" fill="#00f2ff" letter-spacing="1">ROUTE MATCHER</text>
        <line x1="60" y1="100" x2="280" y2="100" stroke="#161b22" stroke-width="4" stroke-linecap="round" />
        <circle cx="60" cy="100" r="8" fill="#00f2ff" filter="url(#glow)"/>
        <circle cx="170" cy="100" r="8" fill="#00f2ff" filter="url(#glow)"/>
        <circle cx="280" cy="100" r="8" fill="#161b22" stroke="#30363d" />
        <rect x="40" y="130" width="260" height="80" rx="6" fill="#161b22" stroke="#30363d" />
        <text x="60" y="160" font-family="Inter, sans-serif" font-size="14" fill="#e6edf3">Revenue Based Financing</text>
        <text x="60" y="185" font-family="Inter, sans-serif" font-size="11" fill="#8b949e">Recommended based on $2M ARR</text>
        <path d="M 270 165 L 285 172.5 L 270 180" fill="none" stroke="#00f2ff" stroke-width="2" />
    </g>

    <!-- 3. Partner Profile -->
    <g transform="translate(800, 180)">
        <rect width="340" height="260" rx="12" fill="#0d1117" stroke="#30363d" stroke-width="1" filter="url(#cardGlow)"/>
        <text x="25" y="40" font-family="Inter, sans-serif" font-size="14" font-weight="600" fill="#00f2ff" letter-spacing="1">PARTNER CARD</text>
        <rect x="135" y="70" width="70" height="70" rx="35" fill="#161b22" stroke="url(#neonGradient)" stroke-width="2" />
        <path d="M 170 85 Q 170 100 155 110 Q 170 100 185 110" fill="none" stroke="#00f2ff" stroke-width="2" />
        <text x="170" y="170" font-family="Inter, sans-serif" font-size="18" font-weight="600" fill="#e6edf3" text-anchor="middle">Acme Growth</text>
        <text x="170" y="190" font-family="Inter, sans-serif" font-size="12" fill="#00ff9d" text-anchor="middle">VERIFIED PARTNER</text>
        <rect x="60" y="210" width="220" height="1" fill="#30363d" />
        <text x="170" y="235" font-family="Inter, sans-serif" font-size="10" fill="#8b949e" text-anchor="middle">52 SUCCESSFUL REFERRALS</text>
    </g>

    <!-- Bottom Row -->

    <!-- 4. Checklist Widget -->
    <g transform="translate(60, 470)">
        <rect width="340" height="260" rx="12" fill="#0d1117" stroke="#30363d" stroke-width="1" />
        <text x="25" y="40" font-family="Inter, sans-serif" font-size="14" font-weight="600" fill="#00f2ff" letter-spacing="1">DOCUMENT CHECKLIST</text>
        <rect x="30" y="80" width="20" height="20" rx="4" fill="#00ff9d" fill-opacity="0.2" stroke="#00ff9d" />
        <path d="M 35 90 L 39 94 L 45 86" fill="none" stroke="#00ff9d" stroke-width="2" />
        <text x="65" y="95" font-family="Inter, sans-serif" font-size="13" fill="#e6edf3">6 Months Bank Statements</text>
        
        <rect x="30" y="120" width="20" height="20" rx="4" fill="#00ff9d" fill-opacity="0.2" stroke="#00ff9d" />
        <path d="M 35 130 L 39 134 L 45 126" fill="none" stroke="#00ff9d" stroke-width="2" />
        <text x="65" y="135" font-family="Inter, sans-serif" font-size="13" fill="#e6edf3">P&amp;L Statements</text>
        
        <rect x="30" y="160" width="20" height="20" rx="4" fill="none" stroke="#30363d" />
        <text x="65" y="175" font-family="Inter, sans-serif" font-size="13" fill="#8b949e">Tax Returns (Last 2 Years)</text>
        
        <rect x="30" y="210" width="280" height="30" rx="6" fill="#161b22" stroke="#30363d" />
        <text x="170" y="230" font-family="Inter, sans-serif" font-size="11" fill="#8b949e" text-anchor="middle">UPLOAD SECURELY</text>
    </g>

    <!-- 5. CTA / Application -->
    <g transform="translate(430, 470)">
        <rect width="710" height="260" rx="12" fill="#0d1117" stroke="#30363d" stroke-width="1" />
        <rect x="40" y="60" width="630" height="140" rx="12" fill="linear-gradient(135deg, #0d1117 0%, #161b22 100%)" stroke="#30363d" />
        <text x="70" y="110" font-family="Inter, sans-serif" font-size="24" font-weight="700" fill="#e6edf3">Ready to scale your business?</text>
        <text x="70" y="140" font-family="Inter, sans-serif" font-size="14" fill="#8b949e">Get a funding decision in as little as 48 hours through Moonshine Capital.</text>
        <rect x="480" y="100" width="160" height="50" rx="6" fill="#00f2ff" filter="url(#glow)" />
        <text x="560" y="131" font-family="Inter, sans-serif" font-size="14" font-weight="700" fill="#05070a" text-anchor="middle">APPLY NOW</text>
        <text x="40" y="235" font-family="Fira Code, monospace" font-size="11" fill="#00ff9d">Powered by Moonshine SDK v2.4.0</text>
    </g>

    <!-- Footer Decoration -->
    <rect x="60" y="770" width="1080" height="1" fill="#30363d" />
    <circle cx="1140" cy="770" r="3" fill="#00f2ff" />
</svg>