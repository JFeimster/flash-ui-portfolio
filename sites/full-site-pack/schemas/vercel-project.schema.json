{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/vercel-project.schema.json",
  "title": "Vercel Project",
  "type": "object",
  "required": [
    "name",
    "repo",
    "status"
  ],
  "properties": {
    "name": {
      "type": "string"
    },
    "project_id": {
      "type": "string"
    },
    "repo": {
      "type": "string"
    },
    "production_url": {
      "type": "string"
    },
    "deployment_enabled": {
      "type": "boolean"
    },
    "framework": {
      "type": "string"
    },
    "status": {
      "type": "string"
    }
  },
  "additionalProperties": true
}
