<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Marketing Kit | Referral Partner Academy</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
    <style>
        :root {
            --navy-deep: #020617;
            --navy-muted: #0f172a;
            --gold: #d4af37;
            --gold-light: #fef3c7;
            --emerald: #10b981;
            --border-color: #e2e8f0;
        }

        body {
            font-family: 'Inter', sans-serif;
            background-color: #f8fafc;
            color: #1e293b;
        }

        .hero-gradient {
            background: linear-gradient(135deg, #020617 0%, #1e293b 100%);
        }

        .academy-card {
            background: white;
            border-radius: 16px;
            border: 1px solid var(--border-color);
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            overflow: hidden;
        }

        .academy-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04);
            border-color: var(--gold);
        }

        .playbook-tag {
            background: var(--gold-light);
            color: #92400e;
            font-size: 0.7rem;
            font-weight: 800;
            text-transform: uppercase;
            padding: 4px 10px;
            border-radius: 6px;
        }

        .btn-gold {
            background: var(--gold);
            color: var(--navy-deep);
            font-weight: 700;
            transition: all 0.2s;
        }

        .btn-gold:hover {
            background: #b8962e;
        }

        .asset-icon {
            width: 48px;
            height: 48px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 12px;
            background: #f1f5f9;
            color: var(--navy-deep);
        }

        .co-brand-overlay {
            background: rgba(2, 6, 23, 0.9);
            backdrop-filter: blur(4px);
        }

        .module-number {
            font-size: 3rem;
            font-weight: 900;
            color: rgba(212, 175, 55, 0.1);
            position: absolute;
            right: 1rem;
            top: 1rem;
            line-height: 1;
        }
    </style>
</head>
<body>

    <!-- Header / Nav -->
    <nav class="bg-white border-b border-slate-200 py-4 px-6 sticky top-0 z-50">
        <div class="max-w-7xl mx-auto flex justify-between items-center">
            <div class="flex items-center gap-2">
                <div class="w-8 h-8 bg-slate-900 rounded flex items-center justify-center">
                    <span class="text-[#d4af37] font-black text-xs">M</span>
                </div>
                <span class="font-black text-slate-900 tracking-tight">MOONSHINE ACADEMY</span>
            </div>
            <div class="flex items-center gap-6 text-sm font-bold text-slate-500">
                <a href="#" class="text-navy-deep">Course Library</a>
                <a href="#" class="hover:text-navy-deep">My Downloads</a>
                <a href="#" class="hover:text-navy-deep">Partner Support</a>
                <button class="bg-slate-100 px-4 py-2 rounded-lg text-slate-900">Back to Tracker</button>
            </div>
        </div>
    </nav>

    <!-- Hero Section -->
    <header class="hero-gradient text-white py-16 px-6">
        <div class="max-w-7xl mx-auto">
            <div class="inline-block bg-emerald-500/20 text-emerald-400 border border-emerald-500/30 px-3 py-1 rounded-full text-xs font-bold uppercase tracking-widest mb-6">
                Active Training Portal
            </div>
            <h1 class="text-4xl md:text-6xl font-black mb-6">Convert Conversations <br><span class="text-[#d4af37]">Into Capital Deals.</span></h1>
            <p class="text-slate-400 text-lg max-w-2xl leading-relaxed">
                Welcome to the Referral Partner Academy. Access tactical playbooks for every persona, co-brandable marketing assets, and email sequences designed to maximize your referral commissions.
            </p>
        </div>
    </header>

    <main class="max-w-7xl mx-auto px-6 -mt-10 mb-20">
        <!-- Stats Bar -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-12">
            <div class="bg-white p-6 rounded-2xl shadow-sm border border-slate-200 flex items-center gap-4">
                <div class="bg-amber-100 p-3 rounded-xl text-amber-600">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path></svg>
                </div>
                <div>
                    <p class="text-xs font-bold text-slate-400 uppercase">Available Playbooks</p>
                    <p class="text-xl font-black text-slate-900">12 Modules</p>
                </div>
            </div>
            <div class="bg-white p-6 rounded-2xl shadow-sm border border-slate-200 flex items-center gap-4">
                <div class="bg-blue-100 p-3 rounded-xl text-blue-600">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg>
                </div>
                <div>
                    <p class="text-xs font-bold text-slate-400 uppercase">Marketing Assets</p>
                    <p class="text-xl font-black text-slate-900">45 Downloads</p>
                </div>
            </div>
            <div class="bg-white p-6 rounded-2xl shadow-sm border border-slate-200 flex items-center gap-4">
                <div class="bg-emerald-100 p-3 rounded-xl text-emerald-600">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon></svg>
                </div>
                <div>
                    <p class="text-xs font-bold text-slate-400 uppercase">New Content</p>
                    <p class="text-xl font-black text-slate-900">Updated Today</p>
                </div>
            </div>
        </div>

        <!-- Section: Tactical Playbooks -->
        <div class="mb-16">
            <div class="flex justify-between items-end mb-8">
                <div>
                    <h2 class="text-3xl font-black text-slate-900">Persona Playbooks</h2>
                    <p class="text-slate-500">Step-by-step scripts and strategies for specific partner types.</p>
                </div>
                <button class="text-sm font-bold text-[#d4af37] underline">View All Personas</button>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
                <!-- Playbook 1 -->
                <div class="academy-card p-6 relative">
                    <span class="module-number">01</span>
                    <span class="playbook-tag mb-4 inline-block">CPA & Accountant</span>
                    <h3 class="text-xl font-bold text-slate-900 mb-3">The Tax Season Bridge</h3>
                    <p class="text-sm text-slate-500 mb-6 leading-relaxed">How to position working capital as a tax strategy tool for business owners facing high liabilities.</p>
                    <div class="flex items-center gap-4">
                        <button class="btn-gold px-4 py-2 rounded-lg text-sm">Start Module</button>
                        <span class="text-xs font-bold text-slate-400">12 min read</span>
                    </div>
                </div>

                <!-- Playbook 2 -->
                <div class="academy-card p-6 relative">
                    <span class="module-number">02</span>
                    <span class="playbook-tag mb-4 inline-block">Payroll Providers</span>
                    <h3 class="text-xl font-bold text-slate-900 mb-3">Pitching the Payroll Gap</h3>
                    <p class="text-sm text-slate-500 mb-6 leading-relaxed">Identifying clients who are struggling with cashflow cycles and need funding to meet employee obligations.</p>
                    <div class="flex items-center gap-4">
                        <button class="btn-gold px-4 py-2 rounded-lg text-sm">Start Module</button>
                        <span class="text-xs font-bold text-slate-400">15 min read</span>
                    </div>
                </div>

                <!-- Playbook 3 -->
                <div class="academy-card p-6 relative border-dashed">
                    <span class="module-number">03</span>
                    <span class="playbook-tag mb-4 inline-block">Business Brokers</span>
                    <h3 class="text-xl font-bold text-slate-900 mb-3">Closing the M&A Gap</h3>
                    <p class="text-sm text-slate-500 mb-6 leading-relaxed">Tactics for funding the 'un-bankable' portions of a business acquisition using asset-based lending.</p>
                    <div class="flex items-center gap-4">
                        <button class="btn-gold px-4 py-2 rounded-lg text-sm">Start Module</button>
                        <span class="text-xs font-bold text-slate-400">10 min read</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Section: Marketing Assets -->
        <div class="bg-slate-900 rounded-3xl p-10 text-white overflow-hidden relative">
            <div class="relative z-10">
                <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-6 mb-10">
                    <div>
                        <h2 class="text-3xl font-black mb-2">Marketing Toolkits</h2>
                        <p class="text-slate-400">Download, co-brand, and send. Professional collateral ready for your logo.</p>
                    </div>
                    <div class="flex bg-slate-800 p-1 rounded-xl">
                        <button class="bg-white text-navy-deep px-4 py-2 rounded-lg text-sm font-bold">PDF Assets</button>
                        <button class="px-4 py-2 rounded-lg text-sm font-bold text-slate-400 hover:text-white">Email Templates</button>
                        <button class="px-4 py-2 rounded-lg text-sm font-bold text-slate-400 hover:text-white">Social Graphics</button>
                    </div>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <!-- Asset 1 -->
                    <div class="bg-white/5 border border-white/10 p-4 rounded-xl flex items-center justify-between hover:bg-white/10 transition-colors group">
                        <div class="flex items-center gap-4">
                            <div class="asset-icon group-hover:bg-[#d4af37] transition-colors">
                                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line><polyline points="10 9 9 9 8 9"></polyline></svg>
                            </div>
                            <div>
                                <h4 class="font-bold">Equipment Finance One-Pager</h4>
                                <p class="text-xs text-slate-500">PDF • 2.4 MB • Co-brand Enabled</p>
                            </div>
                        </div>
                        <button onclick="alert('Starting Co-Branding Tool...')" class="bg-white text-navy-deep p-2 rounded-lg hover:scale-105 transition-transform">
                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg>
                        </button>
                    </div>

                    <!-- Asset 2 -->
                    <div class="bg-white/5 border border-white/10 p-4 rounded-xl flex items-center justify-between hover:bg-white/10 transition-colors group">
                        <div class="flex items-center gap-4">
                            <div class="asset-icon group-hover:bg-[#d4af37] transition-colors">
                                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
                            </div>
                            <div>
                                <h4 class="font-bold">Working Capital Checklist</h4>
                                <p class="text-xs text-slate-500">PDF • 1.1 MB • Universal</p>
                            </div>
                        </div>
                        <button class="bg-white text-navy-deep p-2 rounded-lg hover:scale-105 transition-transform">
                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg>
                        </button>
                    </div>

                    <!-- Asset 3 -->
                    <div class="bg-white/5 border border-white/10 p-4 rounded-xl flex items-center justify-between hover:bg-white/10 transition-colors group">
                        <div class="flex items-center gap-4">
                            <div class="asset-icon group-hover:bg-[#d4af37] transition-colors">
                                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
                            </div>
                            <div>
                                <h4 class="font-bold">Quarterly Market Outlook Email</h4>
                                <p class="text-xs text-slate-500">Copy/Paste Template • HTML</p>
                            </div>
                        </div>
                        <button class="bg-white text-navy-deep p-2 rounded-lg hover:scale-105 transition-transform">
                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"></path><rect x="8" y="2" width="8" height="4" rx="1" ry="1"></rect></svg>
                        </button>
                    </div>

                    <!-- Asset 4 -->
                    <div class="bg-white/5 border border-white/10 p-4 rounded-xl flex items-center justify-between hover:bg-white/10 transition-colors group">
                        <div class="flex items-center gap-4">
                            <div class="asset-icon group-hover:bg-[#d4af37] transition-colors">
                                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect><line x1="8" y1="21" x2="16" y2="21"></line><line x1="12" y1="17" x2="12" y2="21"></line></svg>
                            </div>
                            <div>
                                <h4 class="font-bold">Pitch Deck for Accountants</h4>
                                <p class="text-xs text-slate-500">PPTX • 8.5 MB • Co-brand Enabled</p>
                            </div>
                        </div>
                        <button class="bg-white text-navy-deep p-2 rounded-lg hover:scale-105 transition-transform">
                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg>
                        </button>
                    </div>
                </div>
            </div>
            
            <!-- Abstract background shape -->
            <div class="absolute -right-20 -bottom-20 w-80 h-80 bg-gold opacity-10 rounded-full blur-3xl"></div>
        </div>
    </main>

    <footer class="bg-white border-t border-slate-200 py-12 px-6">
        <div class="max-w-7xl mx-auto flex flex-col md:flex-row justify-between items-center gap-8">
            <div>
                <div class="flex items-center gap-2 mb-4">
                    <div class="w-6 h-6 bg-slate-900 rounded flex items-center justify-center">
                        <span class="text-[#d4af37] font-black text-[10px]">M</span>
                    </div>
                    <span class="font-black text-slate-900 text-sm tracking-tight">MOONSHINE ACADEMY</span>
                </div>
                <p class="text-slate-400 text-xs uppercase font-bold tracking-widest">Training. Tools. Results.</p>
            </div>
            <div class="flex gap-10 text-sm font-bold text-slate-600">
                <a href="#" class="hover:text-navy-deep">Terms of Referral</a>
                <a href="#" class="hover:text-navy-deep">Partner Ethics</a>
                <a href="#" class="hover:text-navy-deep">Compliance Guide</a>
            </div>
            <p class="text-slate-400 text-xs italic">
                &copy; 2024 Moonshine Capital. All rights reserved.
            </p>
        </div>
    </footer>

</body>
</html>